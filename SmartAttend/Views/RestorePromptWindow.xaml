<Window x:Class="SmartAttend.RestorePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Icon="C:\Users\kp\Desktop\smartAttendanceSystem-master\SmartAttend\Assets\smartattend.ico"
        Title="SmartAttend — Restore Backup"
        Height="520"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF3FA">
    <Grid>
        <Border Background="#FFFFFF"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="#D8E4F0"
                Width="340"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="32">
            <StackPanel>

                <!-- Logo -->
                <Border Width="56"
                        Height="56"
                        CornerRadius="14"
                        Background="#EEF3FA"
                        BorderThickness="1"
                        BorderBrush="#D8E4F0"
                        HorizontalAlignment="Center"
                        Margin="0 0 0 14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Background="#1A3A6B"
                                Margin="8 8 4 4"
                                CornerRadius="3" />
                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Background="#1A3A6B"
                                Margin="4 8 8 4"
                                CornerRadius="3" />
                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Background="#1A3A6B"
                                Margin="8 4 4 8"
                                CornerRadius="3" />
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Background="#378ADD"
                                Margin="4 4 8 8"
                                CornerRadius="3" />
                    </Grid>
                </Border>

                <!-- Title -->
                <TextBlock Text="Restore or Start Fresh"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1A3A6B"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Select a backup file to restore, or start fresh"
                           FontSize="11"
                           Foreground="#8AAAC8"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0 4 0 24" />

                <!-- Backup Info Card (hidden until a file is selected) -->
                <Border x:Name="BackupInfoCard"
                        Background="#F0F5FB"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#D8E4F0"
                        Padding="16"
                        Margin="0 0 0 16"
                        Visibility="Collapsed">
                    <StackPanel>

                        <!-- Backup name -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 0 8">
                            <TextBlock Text="📁 "
                                       FontSize="13" />
                            <TextBlock x:Name="TxtBackupName"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1A3A6B"
                                       FontFamily="Segoe UI"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Backup path -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂 "
                                       FontSize="11" />
                            <TextBlock x:Name="TxtBackupPath"
                                       FontSize="10"
                                       Foreground="#8AAAC8"
                                       FontFamily="Segoe UI"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Status / error text -->
                <TextBlock x:Name="TxtStatus"
                           FontSize="11"
                           Foreground="#C0392B"
                           FontFamily="Segoe UI"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="Collapsed"
                           Margin="0 0 0 12" />

                <!-- Select Backup File Button -->
                <Button x:Name="BtnSelectFile"
                        Content="📂  Select Backup File..."
                        Click="BtnSelectFile_Click"
                        Height="40"
                        FontSize="13"
                        FontWeight="SemiBold"
                        FontFamily="Segoe UI"
                        Foreground="#1A3A6B"
                        Cursor="Hand"
                        Margin="0 0 0 8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="#F0F5FB"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="#D8E4F0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bg"
                                            Property="Background"
                                            Value="#E2EAF5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Restore Button (disabled until a file is chosen) -->
                <Button x:Name="BtnRestore"
                        Content="Restore Backup"
                        Click="BtnRestore_Click"
                        IsEnabled="False"
                        Height="40"
                        FontSize="13"
                        FontWeight="SemiBold"
                        FontFamily="Segoe UI"
                        Foreground="White"
                        Cursor="Hand"
                        Margin="0 0 0 8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="#1A3A6B"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bg"
                                            Property="Background"
                                            Value="#22488A" />
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter TargetName="bg"
                                            Property="Background"
                                            Value="#AFC2DC" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Start Fresh Button -->
                <Button x:Name="BtnFresh"
                        Content="Start Fresh"
                        Click="BtnFresh_Click"
                        Height="40"
                        FontSize="13"
                        FontWeight="SemiBold"
                        FontFamily="Segoe UI"
                        Cursor="Hand"
                        Foreground="#1A3A6B">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="Transparent"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="#D8E4F0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bg"
                                            Property="Background"
                                            Value="#F0F5FB" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    
                </Button>

                <!-- Version -->
                <TextBlock Text="Smart Biometric Attendance System v1.0"
                           FontSize="10"
                           Foreground="#8AAAC8"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0 16 0 0" />

            </StackPanel>
        </Border>
    </Grid>
</Window>
