<UserControl x:Class="SmartAttend.View.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#F4F6FB">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <!-- Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- Summary Cards -->
            <RowDefinition Height="Auto" />
            <!-- Chart Strip -->
            <RowDefinition Height="*" />
            <!-- Table -->
        </Grid.RowDefinitions>

        
        <!-- ══════════════════════════════════════════════════════════
             ROW 0 · Filter Bar
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="White"
                BorderThickness="0 0 0 1"
                BorderBrush="#E8EDF5"
                Padding="28 12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <!-- Report type -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Dynamic date -->
                    <ColumnDefinition Width="200" />
                    <!-- Department -->
                    <ColumnDefinition Width="*" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="120" />
                    <!-- Generate -->
                    <ColumnDefinition Width="120" />
                    <!-- Export -->
                </Grid.ColumnDefinitions>

                <!-- Report Type ComboBox -->
                <Border Grid.Column="0"
                        BorderThickness="1"
                        BorderBrush="#DDE4F0"
                        CornerRadius="8"
                        Background="#F8FAFD"
                        Height="34"
                        Margin="0 0 10 0">
                    <ComboBox x:Name="CmbReportType"
                              BorderThickness="0"
                              Background="Transparent"
                              FontSize="12"
                              FontFamily="Segoe UI"
                              Foreground="#1A2F5A"
                              Padding="10 6"
                              VerticalContentAlignment="Center"
                              SelectionChanged="ReportType_Changed">
                        <ComboBoxItem Content="Monthly Report"
                                      IsSelected="True" />
                        <ComboBoxItem Content="Weekly Report" />
                    </ComboBox>
                </Border>

                <!-- Dynamic Date Panel -->
                <!-- Dynamic Date Panel -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Height="34"
                            x:Name="PnlDatePicker">

                    <!-- Monthly -->
                    <Border x:Name="PnlMonthly"
                            BorderThickness="1"
                            BorderBrush="#DDE4F0"
                            CornerRadius="8"
                            Background="#F8FAFD"
                            Margin="0 0 10 0"
                            Visibility="Visible">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="CmbMonth"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      FontSize="12"
                                      FontFamily="Segoe UI"
                                      Foreground="#1A2F5A"
                                      Padding="10 6"
                                      VerticalContentAlignment="Center"
                                      Width="115" />
                            <ComboBox x:Name="CmbYear"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      FontSize="12"
                                      FontFamily="Segoe UI"
                                      Foreground="#1A2F5A"
                                      Padding="6 6"
                                      VerticalContentAlignment="Center"
                                      Width="68" />
                        </StackPanel>
                    </Border>

                    <!-- Weekly: pick END date, start auto-computed (end - 6 days) -->
                    <Border x:Name="PnlWeekly"
                            BorderThickness="1"
                            BorderBrush="#DDE4F0"
                            CornerRadius="8"
                            Background="#F8FAFD"
                            Margin="0 0 10 0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="DpWeek"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        FontSize="12"
                                        FontFamily="Segoe UI"
                                        Foreground="#1A2F5A"
                                        Padding="10 10 6 0"
                                        Width="140"
                                        SelectedDateChanged="DpWeek_SelectedDateChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Computed week range display -->
                    <Border x:Name="PnlWeekRange"
                            BorderThickness="1"
                            BorderBrush="#DDE4F0"
                            CornerRadius="8"
                            Background="#EEF3FA"
                            Margin="0 0 10 0"
                            Visibility="Collapsed"
                            Padding="10 0">
                        <TextBlock x:Name="TxtWeekRange"
                                   Text="—"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="#1A2F5A"
                                   VerticalAlignment="Center" />
                    </Border>

                </StackPanel>

                <!-- Department ComboBox -->
                <Border Grid.Column="2"
                        BorderThickness="1"
                        BorderBrush="#DDE4F0"
                        CornerRadius="8"
                        Background="#F8FAFD"
                        Height="34"
                        Margin="0 0 10 0">
                    <ComboBox x:Name="CmbDepartment"
                              BorderThickness="0"
                              Background="Transparent"
                              FontSize="12"
                              FontFamily="Segoe UI"
                              Foreground="#1A2F5A"
                              Padding="10 6"
                              VerticalContentAlignment="Center" />
                </Border>

                <!-- Spacer -->
                <Grid Grid.Column="3" />

                <!-- Generate Button -->
                <Button Grid.Column="4"
                        Click="Generate_Click"
                        Cursor="Hand"
                        Height="34">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="#1A2F5A"
                                    CornerRadius="8">
                                <TextBlock Text="Generate"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bg"
                                            Property="Background"
                                            Value="#243F78" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="bg"
                                            Property="Background"
                                            Value="#13224A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Export PDF button (top-right, matches Add Employee style) -->
                <Button Grid.Column="5"
                        x:Name="BtnExport"
                        Click="Export_Click"
                        Cursor="Hand"
                        Height="34"
                        Margin="10 0 0 0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="#00B09C"
                                    CornerRadius="10"
                                    Padding="18 0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <!-- PDF icon via path -->
                                    <Viewbox Width="16"
                                             Height="16"
                                             Margin="0 0 8 0">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Path Fill="White"
                                                  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM6 20V4h5v7h7v9H6z" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Export"
                                               FontFamily="Segoe UI"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bg"
                                            Property="Background"
                                            Value="#009688" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="bg"
                                            Property="Background"
                                            Value="#00796B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 1 · Summary Cards  (4 cards, teal accent on Avg Rate)
        ══════════════════════════════════════════════════════════ -->
        <UniformGrid Grid.Row="1"
                     Rows="1"
                     Margin="18 14 18 0">

            <!-- Total Employees -->
            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="0 0 7 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#8A9BBD"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="Total Employees"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtTotalEmployees"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#0D1B2A"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Avg Attendance Rate -->
            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="4 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#00B09C"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="Avg Attendance Rate"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtAvgAttendance"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#00B09C"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                        <TextBlock x:Name="TxtReportPeriod"
                                   Text="—"
                                   FontSize="11"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI"
                                   Margin="0 4 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Perfect Attendance -->
            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="4 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#3B9E5A"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="Perfect Attendance"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtPerfect"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#3B9E5A"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                        <TextBlock x:Name="TxtPerfectSub"
                                   Text="No absences or late"
                                   FontSize="11"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI"
                                   Margin="0 4 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- At Risk -->
            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="7 0 0 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#E05252"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="At Risk"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtAtRisk"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#E05252"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                        <TextBlock Text="Below 60% attendance"
                                   FontSize="11"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI"
                                   Margin="0 4 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

        </UniformGrid>

        <!-- ══════════════════════════════════════════════════════════
             ROW 2 · Chart Strip  (bar chart canvas via code-behind)
        ══════════════════════════════════════════════════════════ -->
        <!-- ══════════════════════════════════════════════════════════
     ROW 2 · Charts  (Trend line + Daily breakdown, side by side)
══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2"
              Margin="18 14 18 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Attendance Trend (Line Chart) -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#E8EDF5"
                    Margin="0 0 7 0"
                    Padding="20 10 ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="130" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               x:Name="TxtLineChartTitle"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1A2F5A"
                               Margin="0 0 0 10" />

                    <Canvas Grid.Row="1"
                            x:Name="LineChartCanvas"
                            Background="Transparent"
                            ClipToBounds="True"
                            Margin="0 5 0 0"
                            SizeChanged="Chart_SizeChanged"/>
                </Grid>
            </Border>

            <!-- Card 2: Daily Breakdown (Stacked Bar Chart) -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#E8EDF5"
                    Margin="7 0 0 0"
                    Padding="20 10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="130" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Daily Breakdown"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#1A2F5A" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Border Width="10"
                                    Height="10"
                                    CornerRadius="2"
                                    Background="#00B09C"
                                    Margin="0 0 4 0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Present"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="#8A9BBD"
                                       Margin="0 0 10 0"
                                       VerticalAlignment="Center" />
                            <Border Width="10"
                                    Height="10"
                                    CornerRadius="2"
                                    Background="#F5A623"
                                    Margin="0 0 4 0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Late"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="#8A9BBD"
                                       Margin="0 0 10 0"
                                       VerticalAlignment="Center" />
                            <Border Width="10"
                                    Height="10"
                                    CornerRadius="2"
                                    Background="#E05252"
                                    Margin="0 0 4 0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Absent"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="#8A9BBD"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Canvas Grid.Row="1"
                            x:Name="StackedBarCanvas"
                            Background="Transparent"
                            ClipToBounds="True" 
                            Margin="0 20 0 0"
                            SizeChanged="Chart_SizeChanged"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="11"
                BorderThickness="1"
                BorderBrush="#E4EAF2"
                Margin="18 10 18 10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Card header — matches Attendance Records style -->
                <Border Grid.Row="0"
                        BorderThickness="0 0 0 1"
                        BorderBrush="#E4EAF2"
                        Padding="18 8 0 8">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Employee Breakdown"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#0D1B2A"
                                       FontFamily="Segoe UI" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <!-- Search box -->
                            <Border BorderThickness="1.5"
                                    BorderBrush="#E4EAF2"
                                    CornerRadius="8"
                                    Background="#F7F9FC"
                                    Height="34"
                                    Width="220"
                                    Margin="0 0 12 0">
                                <Grid>
                                    <Viewbox Width="14"
                                             Height="14"
                                             HorizontalAlignment="Left"
                                             Margin="10 0 0 0"
                                             VerticalAlignment="Center"
                                             IsHitTestVisible="False">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Ellipse Canvas.Left="3"
                                                     Canvas.Top="3"
                                                     Width="13"
                                                     Height="13"
                                                     Stroke="#9EB3CC"
                                                     StrokeThickness="2"
                                                     Fill="Transparent" />
                                            <Line X1="14.5"
                                                  Y1="14.5"
                                                  X2="20"
                                                  Y2="20"
                                                  Stroke="#9EB3CC"
                                                  StrokeThickness="2" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Search by name, ID…"
                                               FontSize="12"
                                               FontFamily="Segoe UI"
                                               Foreground="#9EB3CC"
                                               Margin="32 0 0 0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}"
                                                                 Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtSearch"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#0D1B2A"
                                             Padding="32 0 10 0"
                                             VerticalContentAlignment="Center"
                                             TextChanged="Search_Changed" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="TxtEmptyState"
                                   Text="No data — adjust filters and click Generate"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="#B0BDD8"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          x:Name="ReportGrid"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F4F8"
                          VerticalGridLinesBrush="Transparent"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="White"
                          FontFamily="Segoe UI"
                          FontSize="12"
                          Foreground="#0D1B2A"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          ColumnHeaderHeight="36"
                          RowHeight="52"
                          RowHeaderWidth="0"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar">
                            <Style.Triggers>
                                <Trigger Property="Orientation"
                                         Value="Horizontal">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"
                                    Value="#FAFBFD" />
                            <Setter Property="Foreground"
                                    Value="#9EB3CC" />
                            <Setter Property="FontSize"
                                    Value="11" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                            <Setter Property="Padding"
                                    Value="14 0" />
                            <Setter Property="BorderThickness"
                                    Value="0 0 0 1" />
                            <Setter Property="BorderBrush"
                                    Value="#E4EAF2" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background"
                                    Value="White" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#F7FAFF" />
                                </Trigger>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#F0F4F8" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Setter Property="BorderThickness"
                                    Value="0" />
                            <Setter Property="FocusVisualStyle"
                                    Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="Transparent" />
                                    <Setter Property="Foreground"
                                            Value="#0D1B2A" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>

                        <!-- Employee — rounded-square avatar matching Attendance -->
                        <DataGridTemplateColumn Header="EMPLOYEE"
                                                Width="*"
                                                MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="14 0"
                                                VerticalAlignment="Center">
                                        <Border Width="34"
                                                Height="34"
                                                CornerRadius="9"
                                                Background="{Binding AvatarColor}"
                                                Margin="0 0 10 0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{Binding AvatarTextColor}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0D1B2A"
                                                       FontFamily="Segoe UI" />
                                            <TextBlock Text="{Binding UserId}"
                                                       FontSize="11"
                                                       Foreground="#9EB3CC"
                                                       FontFamily="Segoe UI"
                                                       Margin="0 2 0 0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Department -->
                        <DataGridTemplateColumn Header="DEPARTMENT"
                                                Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Department}"
                                               FontSize="12"
                                               Foreground="#4A6590"
                                               Margin="14 0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Present -->
                        <DataGridTemplateColumn Header="PRESENT"
                                                Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="14 0"
                                                VerticalAlignment="Center">
                                        <Border Width="6"
                                                Height="6"
                                                CornerRadius="3"
                                                Background="#00B09C"
                                                Margin="0 0 6 0"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Present}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#00897B"
                                                   FontFamily="Segoe UI" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Absent -->
                        <DataGridTemplateColumn Header="ABSENT"
                                                Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="14 0"
                                                VerticalAlignment="Center">
                                        <Border Width="6"
                                                Height="6"
                                                CornerRadius="3"
                                                Background="#E05252"
                                                Margin="0 0 6 0"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Absent}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#C94040"
                                                   FontFamily="Segoe UI" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Late -->
                        <DataGridTemplateColumn Header="LATE"
                                                Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="14 0"
                                                VerticalAlignment="Center">
                                        <Border Width="6"
                                                Height="6"
                                                CornerRadius="3"
                                                Background="#F5A623"
                                                Margin="0 0 6 0"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Late}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#D4851B"
                                                   FontFamily="Segoe UI" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Hours -->
                        <DataGridTemplateColumn Header="HOURS"
                                                Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalHours}"
                                               FontFamily="Courier New"
                                               FontSize="11"
                                               Foreground="#6A8BB5"
                                               Margin="14 0"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Rate -->
                        <DataGridTemplateColumn Header="RATE"
                                                Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="14 0"
                                                VerticalAlignment="Center">
                                        <Grid Height="5"
                                              Margin="0 0 0 4">
                                            <Border CornerRadius="3"
                                                    Background="#EEF3FA" />
                                            <Border CornerRadius="3"
                                                    HorizontalAlignment="Left"
                                                    Width="{Binding RateBarWidth}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="#00B09C" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RateColor}"
                                                                         Value="amber">
                                                                <Setter Property="Background"
                                                                        Value="#F5A623" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RateColor}"
                                                                         Value="red">
                                                                <Setter Property="Background"
                                                                        Value="#E05252" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Rate}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="#00897B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RateColor}"
                                                                     Value="amber">
                                                            <Setter Property="Foreground"
                                                                    Value="#D4851B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RateColor}"
                                                                     Value="red">
                                                            <Setter Property="Foreground"
                                                                    Value="#C94040" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>

    </Grid>
</UserControl>
