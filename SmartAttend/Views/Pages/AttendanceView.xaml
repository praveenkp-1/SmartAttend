<UserControl x:Class="SmartAttend.View.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#F7F9FC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ FILTER ROW ═══ -->
        <Border Grid.Row="0"
                Background="White"
                BorderThickness="0 0 0 1"
                BorderBrush="#E4EAF2"
                Padding="18 11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <!-- FIX 1: was missing; Export button was referencing Grid.Column="5"
                                which did not exist. Added explicit column for Export. -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Date Picker -->
                <Border Grid.Column="0"
                        BorderThickness="1.5"
                        BorderBrush="#E4EAF2"
                        CornerRadius="7"
                        Background="#F7F9FC"
                        Height="34"
                        Margin="0 0 8 0">
                    <DatePicker x:Name="DpDate"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="12"
                                FontFamily="Segoe UI"
                                Foreground="#0D1B2A"
                                VerticalContentAlignment="Center"
                                Padding="8 0"
                                SelectedDateChanged="Filter_Changed" />
                </Border>

                <!-- Search Box -->
                <Border Grid.Column="1"
                        BorderThickness="1.5"
                        BorderBrush="#E4EAF2"
                        CornerRadius="8"
                        Background="#F7F9FC"
                        Height="34"
                        Width="260">
                    <Grid>
                        <!-- Search icon -->
                        <Viewbox Width="14"
                                 Height="14"
                                 HorizontalAlignment="Left"
                                 Margin="10 0 0 0"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Canvas Width="24"
                                    Height="24">
                                <Ellipse Canvas.Left="3"
                                         Canvas.Top="3"
                                         Width="13"
                                         Height="13"
                                         Stroke="#9EB3CC"
                                         StrokeThickness="2"
                                         Fill="Transparent" />
                                <Line X1="14.5"
                                      Y1="14.5"
                                      X2="20"
                                      Y2="20"
                                      Stroke="#9EB3CC"
                                      StrokeThickness="2" />
                            </Canvas>
                        </Viewbox>
                        <!-- Placeholder -->
                        <TextBlock Text="Search by name, ID…"
                                   FontSize="12"
                                   FontFamily="Segoe UI"
                                   Foreground="#9EB3CC"
                                   Margin="32 0 0 0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}"
                                                     Value="">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="TxtSearch"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="12"
                                 FontFamily="Segoe UI"
                                 Foreground="#0D1B2A"
                                 Padding="32 0 10 0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="Search_Changed" />
                    </Grid>
                </Border>

                <!-- ═══ FILTER CHIPS ═══ -->
                <!-- FIX 2: Removed redundant BorderBrush/BorderThickness on the
                            outer Border (it had no BorderThickness so it was a no-op).
                            Cleaned up padding to match the other row items. -->
                <Border Grid.Column="2"
                        Padding="18 0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- All chip — FIX 3: "All" chip was hardcoded to always look
                             selected (teal bg + teal border). Normalised it to start
                             in the unselected state; selection highlight is driven from
                             code-behind via the Tag property (same pattern for all chips). -->
                        <Button x:Name="ChipAll"
                                Cursor="Hand"
                                Margin="0 0 6 0"
                                Tag="selected"
                                Click="ChipAll_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg"
                                            CornerRadius="7"
                                            Padding="12 6"
                                            BorderThickness="1.5"
                                            Background="#DFF6F3"
                                            BorderBrush="#00C6AE">
                                        <TextBlock Text="All"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="#007d6e" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Unselected state -->
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="White" />
                                            <Setter TargetName="bg"
                                                    Property="BorderBrush"
                                                    Value="#E4EAF2" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#DFF6F3" />
                                            <Setter TargetName="bg"
                                                    Property="BorderBrush"
                                                    Value="#00C6AE" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Present chip -->
                        <Button x:Name="ChipPresent"
                                Cursor="Hand"
                                Margin="0 0 6 0"
                                Tag=""
                                Click="ChipPresent_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg"
                                            CornerRadius="7"
                                            Padding="12 6"
                                            BorderThickness="1.5"
                                            Background="White"
                                            BorderBrush="#E4EAF2">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Fill="#00C6AE"
                                                     VerticalAlignment="Center"
                                                     Margin="0 0 6 0" />
                                            <TextBlock Text="Present"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Segoe UI"
                                                       Foreground="#5E708A" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="selected">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#DFF6F3" />
                                            <Setter TargetName="bg"
                                                    Property="BorderBrush"
                                                    Value="#00C6AE" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#DFF6F3" />
                                            <Setter TargetName="bg"
                                                    Property="BorderBrush"
                                                    Value="#00C6AE" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Absent chip -->
                        <Button x:Name="ChipAbsent"
                                Cursor="Hand"
                                Margin="0 0 6 0"
                                Tag=""
                                Click="ChipAbsent_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg"
                                            CornerRadius="7"
                                            Padding="12 6"
                                            BorderThickness="1.5"
                                            Background="White"
                                            BorderBrush="#E4EAF2">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Fill="#FF5A5A"
                                                     VerticalAlignment="Center"
                                                     Margin="0 0 6 0" />
                                            <TextBlock Text="Absent"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Segoe UI"
                                                       Foreground="#5E708A" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="selected">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#FFE5E5" />
                                            <Setter TargetName="bg"
                                                    Property="BorderBrush"
                                                    Value="#FF5A5A" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#FFE5E5" />
                                            <Setter TargetName="bg"
                                                    Property="BorderBrush"
                                                    Value="#FF5A5A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Late chip -->
                        <Button x:Name="ChipLate"
                                Cursor="Hand"
                                Margin="0 0 6 0"
                                Tag=""
                                Click="ChipLate_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg"
                                            CornerRadius="7"
                                            Padding="12 6"
                                            BorderThickness="1.5"
                                            Background="White"
                                            BorderBrush="#E4EAF2">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Fill="#F59E0B"
                                                     VerticalAlignment="Center"
                                                     Margin="0 0 6 0" />
                                            <TextBlock Text="Late"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Segoe UI"
                                                       Foreground="#5E708A" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                     Value="selected">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#FEF3D0" />
                                            <Setter TargetName="bg"
                                                    Property="BorderBrush"
                                                    Value="#F59E0B" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#FEF3D0" />
                                            <Setter TargetName="bg"
                                                    Property="BorderBrush"
                                                    Value="#F59E0B" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- Export Button — FIX 1: corrected Grid.Column from 5 → 3 -->
                <Button Grid.Column="3"
                        x:Name="BtnExport"
                        Cursor="Hand"
                        Height="34"
                        Margin="10 0 0 0"
                        Click="ExportPdf_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="#00B09C"
                                    CornerRadius="10"
                                    Padding="18 0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Viewbox Width="16"
                                             Height="16"
                                             Margin="0 0 8 0">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Path Fill="White"
                                                  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM6 20V4h5v7h7v9H6z" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Export"
                                               FontFamily="Segoe UI"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bg"
                                            Property="Background"
                                            Value="#009688" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="bg"
                                            Property="Background"
                                            Value="#00796B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
        </Border>

        <!-- ═══ MINI STAT CARDS ═══
             FIX 4: Added bottom margin (14 → "14 14") so cards don't sit flush
                     against the table border below. -->
        <UniformGrid Grid.Row="1"
                     Rows="1"
                     Margin="18 14 18 14">

            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="0 0 7 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#00C6AE"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="Total Records"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtStatTotal"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#0D1B2A"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="4 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#00C6AE"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="Present"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtStatPresent"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#00C6AE"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="4 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#FF5A5A"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="Absent"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtStatAbsent"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#FF5A5A"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="7 0 0 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#F59E0B"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="Late"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtStatLate"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#F59E0B"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

        </UniformGrid>

        <!-- ═══ ATTENDANCE TABLE ═══ -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="11"
                BorderThickness="1"
                BorderBrush="#E4EAF2"
                Margin="18 0 18 10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Card header -->
                <Border Grid.Row="0"
                        BorderThickness="0 0 0 1"
                        BorderBrush="#E4EAF2"
                        Padding="18 13">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Attendance Records"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#0D1B2A"
                                       FontFamily="Segoe UI" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border Background="#DFF6F3"
                                    CornerRadius="5"
                                    Padding="8 3"
                                    Margin="0 0 10 0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5"
                                             Height="5"
                                             Fill="#00C6AE"
                                             VerticalAlignment="Center"
                                             Margin="0 0 5 0" />
                                    <TextBlock Text="LIVE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#00C6AE"
                                               FontFamily="Segoe UI" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="TxtCardDate"
                                       FontSize="11"
                                       Foreground="#9EB3CC"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DataGrid
                     FIX 5: Changed VerticalScrollBarVisibility from "Hidden" (hides
                             bar but reserves space) to "Auto" so the scrollbar
                             appears only when rows overflow the panel. -->
                <DataGrid x:Name="AttendanceGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F4F8"
                          VerticalGridLinesBrush="Transparent"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="White"
                          FontFamily="Segoe UI"
                          FontSize="12"
                          Foreground="#0D1B2A"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          ColumnHeaderHeight="36"
                          RowHeight="52"
                          RowHeaderWidth="0"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar">
                            <Style.Triggers>
                                <Trigger Property="Orientation"
                                         Value="Horizontal">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"
                                    Value="#FAFBFD" />
                            <Setter Property="Foreground"
                                    Value="#9EB3CC" />
                            <Setter Property="FontSize"
                                    Value="11" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                            <Setter Property="Padding"
                                    Value="14 0" />
                            <Setter Property="BorderThickness"
                                    Value="0 0 0 1" />
                            <Setter Property="BorderBrush"
                                    Value="#E4EAF2" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Setter Property="BorderThickness"
                                    Value="0" />
                            <Setter Property="FocusVisualStyle"
                                    Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#F0F4F8" />
                                    <Setter Property="Foreground"
                                            Value="#0D1B2A" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>

                        <!-- Employee -->
                        <DataGridTemplateColumn Header="EMPLOYEE"
                                                Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="14 0"
                                                VerticalAlignment="Center">
                                        <Border Width="34"
                                                Height="34"
                                                CornerRadius="9"
                                                Background="{Binding AvatarColor}"
                                                Margin="0 0 10 0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       FontFamily="Segoe UI"
                                                       Foreground="{Binding AvatarTextColor}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0D1B2A"
                                                       FontFamily="Segoe UI" />
                                            <TextBlock Text="{Binding UserId}"
                                                       FontSize="11"
                                                       Foreground="#9EB3CC"
                                                       FontFamily="Segoe UI"
                                                       Margin="0 2 0 0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Check In -->
                        <DataGridTemplateColumn Header="CHECK IN"
                                                Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CheckIn}"
                                               FontSize="12"
                                               Foreground="#0D1B2A"
                                               FontFamily="Segoe UI"
                                               Margin="14 0"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Check Out -->
                        <DataGridTemplateColumn Header="CHECK OUT"
                                                Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CheckOut}"
                                               FontSize="12"
                                               Foreground="#0D1B2A"
                                               FontFamily="Segoe UI"
                                               Margin="14 0"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Hours -->
                        <DataGridTemplateColumn Header="HOURS"
                                                Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Hours}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#0D1B2A"
                                               FontFamily="Segoe UI"
                                               Margin="14 0"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status -->
                        <DataGridTemplateColumn Header="STATUS"
                                                Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5"
                                            Padding="8 3"
                                            HorizontalAlignment="Left"
                                            Margin="14 0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="#D0F5F0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="Absent">
                                                        <Setter Property="Background"
                                                                Value="#FFE5E5" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="Late">
                                                        <Setter Property="Background"
                                                                Value="#FEF3D0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="Checked Out">
                                                        <Setter Property="Background"
                                                                Value="#E8EDF5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="#007d6e" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Absent">
                                                            <Setter Property="Foreground"
                                                                    Value="#cc2a2a" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Late">
                                                            <Setter Property="Foreground"
                                                                    Value="#92400e" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Checked Out">
                                                            <Setter Property="Foreground"
                                                                    Value="#1E3A5F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Method -->
                        <DataGridTemplateColumn Header="METHOD"
                                                Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5"
                                            Padding="8 3"
                                            HorizontalAlignment="Left"
                                            Margin="14 0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="#EDE9FF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Method}"
                                                                 Value="RFID">
                                                        <Setter Property="Background"
                                                                Value="#DBEAFE" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Method}"
                                                                 Value="PIN">
                                                        <Setter Property="Background"
                                                                Value="#FEF3D0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Method}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="#6d28d9" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Method}"
                                                                     Value="RFID">
                                                            <Setter Property="Foreground"
                                                                    Value="#1d4ed8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Method}"
                                                                     Value="PIN">
                                                            <Setter Property="Foreground"
                                                                    Value="#92400e" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
