<UserControl x:Class="SmartAttend.View.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmartAttend.View"
             mc:Ignorable="d"
             d:DesignHeight="2274.312"
             d:DesignWidth="950"
             Background="#F4F6FB">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════
             LEFT — Sidebar Navigation
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                CornerRadius="12"
                BorderThickness="1"
                
                VerticalAlignment="Top">
            <StackPanel x:Name="SidebarPanel">

                <!-- General -->
                <Border x:Name="NavGeneral"
                        Tag="General"
                        CornerRadius="8"
                        Background="#E3F8F2"
                        Margin="0 0 0 4"
                        Cursor="Hand"
                        MouseLeftButtonUp="NavItem_Click">
                    <StackPanel Orientation="Horizontal"
                                Margin="10 9">
                        <TextBlock Text="⚙"
                                   FontSize="13"
                                   Foreground="#00C9A7"
                                   Width="22"
                                   Margin="0 0 10 0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="General"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#00C9A7"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Attendance Rules -->
                <Border x:Name="NavAttendanceRules"
                        Tag="AttendanceRules"
                        CornerRadius="8"
                        Background="Transparent"
                        Margin="0 0 0 4"
                        Cursor="Hand"
                        MouseLeftButtonUp="NavItem_Click">
                    <StackPanel Orientation="Horizontal"
                                Margin="10 9">
                        <TextBlock Text="🗓"
                                   FontSize="13"
                                   Foreground="#5E708A"
                                   Width="22"
                                   Margin="0 0 10 0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Attendance Rules"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4A6590"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Device Settings -->
                <Border x:Name="NavDeviceSettings"
                        Tag="DeviceSettings"
                        CornerRadius="8"
                        Background="Transparent"
                        Margin="0 0 0 4"
                        Cursor="Hand"
                        MouseLeftButtonUp="NavItem_Click">
                    <StackPanel Orientation="Horizontal"
                                Margin="10 9">
                        <TextBlock Text="📶"
                                   FontSize="13"
                                   Foreground="#5E708A"
                                   Width="22"
                                   Margin="0 0 10 0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Device Settings"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4A6590"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Device Config -->
                <Border x:Name="NavDeviceConfig"
                        Tag="DeviceConfig"
                        CornerRadius="8"
                        Background="Transparent"
                        Margin="0 0 0 4"
                        Cursor="Hand"
                        MouseLeftButtonUp="NavItem_Click">
                    <StackPanel Orientation="Horizontal"
                                Margin="10 9">
                        <TextBlock Text="🖧"
                                   FontSize="13"
                                   Foreground="#5E708A"
                                   Width="22"
                                   Margin="0 0 10 0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Device Config"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4A6590"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Departments -->
                <Border x:Name="NavDepartments"
                        Tag="Departments"
                        CornerRadius="8"
                        Background="Transparent"
                        Margin="0 0 0 4"
                        Cursor="Hand"
                        MouseLeftButtonUp="NavItem_Click">
                    <StackPanel Orientation="Horizontal"
                                Margin="10 9">
                        <TextBlock Text="🏷"
                                   FontSize="13"
                                   Foreground="#5E708A"
                                   Width="22"
                                   Margin="0 0 10 0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Departments"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4A6590"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Security -->
                <Border x:Name="NavSecurity"
                        Tag="Security"
                        CornerRadius="8"
                        Background="Transparent"
                        Margin="0 0 0 4"
                        Cursor="Hand"
                        MouseLeftButtonUp="NavItem_Click">
                    <StackPanel Orientation="Horizontal"
                                Margin="10 9">
                        <TextBlock Text="🛡"
                                   FontSize="13"
                                   Foreground="#5E708A"
                                   Width="22"
                                   Margin="0 0 10 0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Security"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4A6590"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Backup -->
                <Border x:Name="NavBackup"
                        Tag="Backup"
                        CornerRadius="8"
                        Background="Transparent"
                        Margin="0 0 0 4"
                        Cursor="Hand"
                        MouseLeftButtonUp="NavItem_Click">
                    <StackPanel Orientation="Horizontal"
                                Margin="10 9">
                        <TextBlock Text="☁"
                                   FontSize="13"
                                   Foreground="#5E708A"
                                   Width="22"
                                   Margin="0 0 10 0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Backup &amp; Sync"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4A6590"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             RIGHT — Content Sections
        ══════════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="MainScroller"
            Grid.Column="2"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel>

                <!-- ══════════ GENERAL (static for now) ══════════ -->
                <Border x:Name="SectionGeneral"
                        Background="White"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#E8EDF5"
                        Padding="22"
                        Margin="0 0 0 16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 0 18">
                            <TextBlock Text="⚙"
                                       FontSize="14"
                                       Foreground="#00C9A7"
                                       Margin="0 0 8 0" />
                            <TextBlock Text="General Settings"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0D1B2A"
                                       FontFamily="Segoe UI" />
                        </StackPanel>

                        <!-- Company Name + Admin Username -->
                        <Grid Margin="0 0 0 20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="COMPANY NAME"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtCompanyName"
                                             Text="Acme Corporation"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ADMIN USERNAME"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtAdminUsername"
                                             Text="admin"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>
                            
                        </Grid>
                        <Button Content="Save"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                FontFamily="Segoe UI"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Cursor="Hand"
                                Height="38"
                                Width="120"
                                Margin="0 16 0 0"
                                Click="SaveGeneral_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg"
                                            Background="#00C9A7"
                                            CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#00B09A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Dark Mode 
                        <Grid Margin="0 0 0 16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Dark Mode"
                                           FontSize="13"
                                           Foreground="#1A2F5A"
                                           FontFamily="Segoe UI"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Switch to dark theme"
                                           FontSize="10"
                                           Foreground="#8A9BBD"
                                           FontFamily="Segoe UI"
                                           Margin="0 2 0 0" />
                            </StackPanel>
                            <Border x:Name="ToggleDarkMode"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="#DDE4F0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <Ellipse Width="14"
                                         Height="14"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         Margin="3 0 0 0" />
                            </Border>
                        </Grid>  -->

                        <!-- Auto-start with Windows
                        <Grid Margin="0 0 0 16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Auto-start with Windows"
                                           FontSize="13"
                                           Foreground="#1A2F5A"
                                           FontFamily="Segoe UI"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Launch SmartAttend on startup"
                                           FontSize="10"
                                           Foreground="#8A9BBD"
                                           FontFamily="Segoe UI"
                                           Margin="0 2 0 0" />
                            </StackPanel>
                            <Border x:Name="ToggleAutoStart"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="#00C9A7"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <Ellipse Width="14"
                                         Height="14"
                                         Fill="White"
                                         HorizontalAlignment="Right"
                                         Margin="0 0 3 0" />
                            </Border>
                        </Grid> -->

                        <!-- Minimize to System Tray 
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Minimize to System Tray"
                                           FontSize="13"
                                           Foreground="#1A2F5A"
                                           FontFamily="Segoe UI"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Keep running in background"
                                           FontSize="10"
                                           Foreground="#8A9BBD"
                                           FontFamily="Segoe UI"
                                           Margin="0 2 0 0" />
                            </StackPanel>
                            <Border x:Name="ToggleMinimizeTray"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="#00C9A7"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <Ellipse Width="14"
                                         Height="14"
                                         Fill="White"
                                         HorizontalAlignment="Right"
                                         Margin="0 0 3 0" />
                            </Border>
                        </Grid> -->

                    </StackPanel>
                    
                </Border>

                <!-- ══════════ ATTENDANCE RULES ══════════ -->
                <Border x:Name="SectionAttendanceRules"
                        Background="White"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#E8EDF5"
                        Padding="22"
                        Margin="0 0 0 16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 0 18">
                            <TextBlock Text="🗓"
                                       FontSize="14"
                                       Foreground="#00C9A7"
                                       Margin="0 0 8 0" />
                            <TextBlock Text="Attendance Rules"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0D1B2A"
                                       FontFamily="Segoe UI" />
                        </StackPanel>

                        <!-- Work Start / Work End / Grace Period -->
                        <Grid Margin="0 0 0 20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="WORK START TIME"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtStartTime"
                                             Text="08:30"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="WORK END TIME"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtEndTime"
                                             Text="17:00"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="LATE GRACE (MINS)"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtGracePeriod"
                                             Text="10"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Authentication Mode -->
                        <Grid Margin="0 0 0 20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Authentication mode"
                                           FontSize="13"
                                           Foreground="#1A2F5A"
                                           FontFamily="Segoe UI"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Method required at device"
                                           FontSize="10"
                                           Foreground="#8A9BBD"
                                           FontFamily="Segoe UI"
                                           Margin="0 2 0 0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    BorderThickness="1"
                                    BorderBrush="#DDE4F0"
                                    CornerRadius="8"
                                    Background="#F8FAFD"
                                    VerticalAlignment="Center">
                                <ComboBox x:Name="CmbAuthMode"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          Foreground="#1A2F5A"
                                          FontSize="12"
                                          FontFamily="Segoe UI"
                                          Padding="10 7"
                                          Width="150"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Any method"
                                                  Tag="0" />
                                    <ComboBoxItem Content="RFID only"
                                                  Tag="1" />
                                    <ComboBoxItem Content="Fingerprint only"
                                                  Tag="2" />
                                    <ComboBoxItem Content="PIN only"
                                                  Tag="3" />
                                    <ComboBoxItem Content="FP + RFID (2FA)"
                                                  Tag="4" />
                                    <ComboBoxItem Content="FP + PIN (2FA)"
                                                  Tag="5" />
                                    <ComboBoxItem Content="RFID + PIN (2FA)"
                                                  Tag="6" />
                                </ComboBox>
                            </Border>
                        </Grid>

                        <!-- Save Button -->
                        <Button Content="Save Rules"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                FontFamily="Segoe UI"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Cursor="Hand"
                                Height="38"
                                Width="140"
                                Click="SaveRules_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg"
                                            Background="#00C9A7"
                                            CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#00B09A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- ══════════ DEVICE SETTINGS ══════════ -->
                <Border x:Name="SectionDeviceSettings"
                        Background="White"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#E8EDF5"
                        Padding="22"
                        Margin="0 0 0 16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 0 18">
                            <TextBlock Text="📶"
                                       FontSize="14"
                                       Foreground="#00C9A7"
                                       Margin="0 0 8 0" />
                            <TextBlock Text="Device Settings"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0D1B2A"
                                       FontFamily="Segoe UI" />
                        </StackPanel>

                        <!-- Auto Sync -->
                        <Grid Margin="0 0 0 16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Auto-sync with device"
                                           FontSize="13"
                                           Foreground="#1A2F5A"
                                           FontFamily="Segoe UI"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Sync attendance every 30 seconds"
                                           FontSize="10"
                                           Foreground="#8A9BBD"
                                           FontFamily="Segoe UI"
                                           Margin="0 2 0 0" />
                            </StackPanel>
                            <Border x:Name="ToggleAutoSync"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="#00C9A7"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    MouseLeftButtonUp="ToggleAutoSync_Click">
                                <Ellipse x:Name="DotAutoSync"
                                         Width="14"
                                         Height="14"
                                         Fill="White"
                                         HorizontalAlignment="Right"
                                         Margin="0 0 3 0" />
                            </Border>
                        </Grid>

                        <!-- SD Card -->
                        <Grid Margin="0 0 0 16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SD card backup"
                                           FontSize="13"
                                           Foreground="#1A2F5A"
                                           FontFamily="Segoe UI"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Save logs on device locally"
                                           FontSize="10"
                                           Foreground="#8A9BBD"
                                           FontFamily="Segoe UI"
                                           Margin="0 2 0 0" />
                            </StackPanel>
                            <Border x:Name="ToggleSdBackup"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="#00C9A7"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    MouseLeftButtonUp="ToggleSdBackup_Click">
                                <Ellipse x:Name="DotSdBackup"
                                         Width="14"
                                         Height="14"
                                         Fill="White"
                                         HorizontalAlignment="Right"
                                         Margin="0 0 3 0" />
                            </Border>
                        </Grid>

                        <!-- Buzzer -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Buzzer feedback"
                                           FontSize="13"
                                           Foreground="#1A2F5A"
                                           FontFamily="Segoe UI"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Audio on auth success or fail"
                                           FontSize="10"
                                           Foreground="#8A9BBD"
                                           FontFamily="Segoe UI"
                                           Margin="0 2 0 0" />
                            </StackPanel>
                            <Border x:Name="ToggleBuzzer"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="#00C9A7"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    MouseLeftButtonUp="ToggleBuzzer_Click">
                                <Ellipse x:Name="DotBuzzer"
                                         Width="14"
                                         Height="14"
                                         Fill="White"
                                         HorizontalAlignment="Right"
                                         Margin="0 0 3 0" />
                            </Border>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ══════════ DEVICE CONFIG ══════════ -->
                <Border x:Name="SectionDeviceConfig"
                        Background="White"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#E8EDF5"
                        Padding="22"
                        Margin="0 0 0 16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 0 18">
                            <TextBlock Text="🖧"
                                       FontSize="14"
                                       Foreground="#00C9A7"
                                       Margin="0 0 8 0" />
                            <TextBlock Text="Device Configuration"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0D1B2A"
                                       FontFamily="Segoe UI" />
                        </StackPanel>

                        <!-- Scan Row -->
                        <Grid Margin="0 0 0 16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Border BorderThickness="1"
                                    BorderBrush="#DDE4F0"
                                    CornerRadius="8"
                                    Background="#F8FAFD"
                                    Margin="0 0 8 0">
                                <TextBox x:Name="TxtScanStatus"
                                         Text="Enter IP or click Scan to find devices"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="12"
                                         FontFamily="Segoe UI"
                                         Foreground="#8A9BBD"
                                         Padding="12 9"
                                         IsReadOnly="True" />
                            </Border>
                            <Button Grid.Column="1"
                                    Content="🔍 Scan Network"
                                    FontSize="12"
                                    FontFamily="Segoe UI"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Height="38"
                                    Click="Scan_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg"
                                                Background="#1A2F5A"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="bg"
                                                        Property="Background"
                                                        Value="#22488A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Device Name + IP -->
                        <Grid Margin="0 0 0 14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DEVICE NAME"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtDeviceName"
                                             Text="Main Entrance"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IP ADDRESS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtDeviceIP"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Port + Device Key -->
                        <Grid Margin="0 0 0 14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PORT"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtDevicePort"
                                             Text="5001"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DEVICE KEY (Optional)"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtDeviceKey"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- WiFi SSID + Password -->
                        <Grid Margin="0 0 0 14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="WIFI SSID"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtWifiSSID"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="WIFI PASSWORD"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <PasswordBox x:Name="TxtWifiPassword"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="12"
                                                 FontFamily="Segoe UI"
                                                 Foreground="#1A2F5A"
                                                 Padding="12 9" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Error -->
                        <TextBlock x:Name="TxtError"
                                   Text=""
                                   FontSize="11"
                                   Foreground="#C0392B"
                                   FontFamily="Segoe UI"
                                   Visibility="Collapsed"
                                   Margin="0 0 0 10" />

                        <!-- Connect Button -->
                        <Button Content="Connect Device"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                FontFamily="Segoe UI"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Cursor="Hand"
                                Height="38"
                                Width="150"
                                Margin="0 0 0 20"
                                Click="Connect_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg"
                                            Background="#00C9A7"
                                            CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#00B09A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border BorderThickness="0 1 0 0"
                                BorderBrush="#EEF3FA"
                                Margin="0 0 0 16" />

                        <TextBlock Text="CONNECTED DEVICES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI"
                                   Margin="0 0 0 12" />

                        <!-- Connected devices list -->
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1"
                                            BorderBrush="#DDE4F0"
                                            CornerRadius="8"
                                            Background="#F8FAFD"
                                            Padding="14 12"
                                            Margin="0 0 0 8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     Width="10"
                                                     Height="10"
                                                     Margin="0 0 12 0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill"
                                                                Value="#C0392B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="Online">
                                                                <Setter Property="Fill"
                                                                        Value="#00C9A7" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1A2F5A"
                                                           FontFamily="Segoe UI" />
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0 3 0 0">
                                                    <TextBlock Text="{Binding IPAddress}"
                                                               FontSize="11"
                                                               Foreground="#8A9BBD"
                                                               FontFamily="Consolas" />
                                                    <TextBlock Text=" · Port: "
                                                               FontSize="11"
                                                               Foreground="#8A9BBD"
                                                               FontFamily="Segoe UI" />
                                                    <TextBlock Text="{Binding Port}"
                                                               FontSize="11"
                                                               Foreground="#8A9BBD"
                                                               FontFamily="Segoe UI" />
                                                    <TextBlock Text=" · v"
                                                               FontSize="11"
                                                               Foreground="#8A9BBD" />
                                                    <TextBlock Text="{Binding FirmwareVersion}"
                                                               FontSize="11"
                                                               Foreground="#8A9BBD"
                                                               FontFamily="Segoe UI" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LastSeen}"
                                                           FontSize="10"
                                                           Foreground="#8A9BBD"
                                                           FontFamily="Segoe UI"
                                                           Margin="0 2 0 0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Test"
                                                        FontSize="11"
                                                        FontFamily="Segoe UI"
                                                        Foreground="#1A2F5A"
                                                        Cursor="Hand"
                                                        Margin="0 0 6 0"
                                                        Tag="{Binding IPAddress}"
                                                        Click="TestDevice_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg"
                                                                    Background="White"
                                                                    CornerRadius="6"
                                                                    BorderThickness="1"
                                                                    BorderBrush="#DDE4F0"
                                                                    Padding="10 5">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter TargetName="bg"
                                                                            Property="Background"
                                                                            Value="#EEF3FA" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Content="Remove"
                                                        FontSize="11"
                                                        FontFamily="Segoe UI"
                                                        Foreground="#C0392B"
                                                        Cursor="Hand"
                                                        Tag="{Binding Id}"
                                                        Click="RemoveDevice_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg"
                                                                    Background="White"
                                                                    CornerRadius="6"
                                                                    BorderThickness="1"
                                                                    BorderBrush="#FCEBEB"
                                                                    Padding="10 5">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter TargetName="bg"
                                                                            Property="Background"
                                                                            Value="#FCEBEB" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="TxtNoDevices"
                                   Text="No devices connected yet."
                                   FontSize="12"
                                   Foreground="#8A9BBD"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   Margin="0 16 0 0"
                                   Visibility="Visible" />

                    </StackPanel>
                </Border>

                <!-- ══════════ DEPARTMENTS ══════════ -->
                <Border x:Name="SectionDepartments"
                        Background="White"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#E8EDF5"
                        Padding="22"
                        Margin="0 0 0 16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 0 18">
                            <TextBlock Text="🏷"
                                       FontSize="14"
                                       Foreground="#00C9A7"
                                       Margin="0 0 8 0" />
                            <TextBlock Text="Department Management"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0D1B2A"
                                       FontFamily="Segoe UI" />
                        </StackPanel>

                        <!-- Add Row -->
                        <Grid Margin="0 0 0 16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Border BorderThickness="1"
                                    BorderBrush="#DDE4F0"
                                    CornerRadius="8"
                                    Background="#F8FAFD"
                                    Margin="0 0 8 0">
                                <TextBox x:Name="TxtDepartment"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="12"
                                         FontFamily="Segoe UI"
                                         Foreground="#1A2F5A"
                                         Padding="12 9" />
                            </Border>
                            <Button Grid.Column="1"
                                    Content="+ Add"
                                    FontSize="12"
                                    FontFamily="Segoe UI"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Height="38"
                                    Click="AddDepartment_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg"
                                                Background="#00C9A7"
                                                CornerRadius="9">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="bg"
                                                        Property="Background"
                                                        Value="#00B09A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Department List -->
                        <ItemsControl x:Name="DepartmentList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0 0 0 8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border BorderThickness="1"
                                                BorderBrush="#DDE4F0"
                                                CornerRadius="8"
                                                Background="#F8FAFD"
                                                Padding="12 9">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="12"
                                                       Foreground="#1A2F5A"
                                                       FontFamily="Segoe UI" />
                                        </Border>
                                        <Button Grid.Column="1"
                                                Content="✕"
                                                FontSize="11"
                                                FontFamily="Segoe UI"
                                                Foreground="#C0392B"
                                                Cursor="Hand"
                                                Margin="8 0 0 0"
                                                Tag="{Binding}"
                                                Click="DeleteDepartment_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg"
                                                            Background="White"
                                                            CornerRadius="8"
                                                            BorderThickness="1"
                                                            BorderBrush="#FCEBEB"
                                                            Padding="10 6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter TargetName="bg"
                                                                    Property="Background"
                                                                    Value="#FCEBEB" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- ══════════ SECURITY ══════════ -->
                <Border x:Name="SectionSecurity"
                        Background="White"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#E8EDF5"
                        Padding="22"
                        Margin="0 0 0 16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 0 18">
                            <TextBlock Text="🛡"
                                       FontSize="14"
                                       Foreground="#00C9A7"
                                       Margin="0 0 8 0" />
                            <TextBlock Text="Security"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0D1B2A"
                                       FontFamily="Segoe UI" />
                        </StackPanel>

                        <!-- Current Password -->
                        <TextBlock Text="CURRENT PASSWORD"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI"
                                   Margin="0 0 0 6" />
                        <Border BorderThickness="1"
                                BorderBrush="#DDE4F0"
                                CornerRadius="8"
                                Background="#F8FAFD"
                                Margin="0 0 0 14">
                            <PasswordBox x:Name="TxtCurretPassword"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="12"
                                         FontFamily="Segoe UI"
                                         Foreground="#1A2F5A"
                                         Padding="12 9" />
                        </Border>

                        <!-- New Password + Confirm Password -->
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NEW PASSWORD"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <PasswordBox x:Name="TxtPassword"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="12"
                                                 FontFamily="Segoe UI"
                                                 Foreground="#1A2F5A"
                                                 Padding="12 9" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CONFIRM PASSWORD"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <PasswordBox x:Name="TxtConfirmPassword"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="12"
                                                 FontFamily="Segoe UI"
                                                 Foreground="#1A2F5A"
                                                 Padding="12 9" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Error Message -->
                        <TextBlock x:Name="TxtPasswordError"
                                   Text=""
                                   FontSize="11"
                                   Foreground="#C0392B"
                                   FontFamily="Segoe UI"
                                   Margin="0 8 0 0"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap" />

                        <!-- Change Button -->
                        <Button x:Name="BtnChange"
                                Content="Change Password"
                                Click="Change_Click"
                                HorizontalAlignment="Left"
                                Height="38"
                                Width="160"
                                FontSize="12"
                                FontWeight="SemiBold"
                                FontFamily="Segoe UI"
                                Foreground="White"
                                Cursor="Hand"
                                Margin="0 14 0 20">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg"
                                            Background="#00C9A7"
                                            CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#00B09A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border BorderThickness="0 1 0 0"
                                BorderBrush="#EEF3FA"
                                Margin="0 0 0 16" />

                        <!-- Require Login on Start (visual only) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Require Login on Start"
                                           FontSize="13"
                                           Foreground="#1A2F5A"
                                           FontFamily="Segoe UI"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Ask for manager password every time the app opens"
                                           FontSize="10"
                                           Foreground="#8A9BBD"
                                           FontFamily="Segoe UI"
                                           Margin="0 2 0 0" />
                            </StackPanel>
                            <Border x:Name="ToggleRequireLogin"
                                    Grid.Column="1"
                                    Width="36"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="#00C9A7"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    MouseLeftButtonUp="ToggleRequireLogin_Click">
                                <Ellipse x:Name="DotRequireLogin"
                                         Width="14"
                                         Height="14"
                                         Fill="White"
                                         HorizontalAlignment="Right"
                                         Margin="0 0 3 0" />
                            </Border>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ══════════ BACKUP & SYNC ══════════ -->
                <Border x:Name="SectionBackup"
                        Background="White"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#E8EDF5"
                        Padding="22">
                    <StackPanel>

                        <!-- Section Title -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 0 18">
                            <TextBlock Text="☁"
                                       FontSize="14"
                                       Foreground="#00C9A7"
                                       Margin="0 0 8 0" />
                            <TextBlock Text="Backup &amp; Sync"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#0D1B2A"
                                       FontFamily="Segoe UI" />
                        </StackPanel>

                        <!-- Backup Folder Path -->
                        <TextBlock Text="BACKUP FOLDER"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#8A9BBD"
                                   FontFamily="Segoe UI"
                                   Margin="0 0 0 6" />
                        <Grid Margin="0 0 0 16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border BorderThickness="1"
                                    BorderBrush="#E8EDF5"
                                    CornerRadius="8"
                                    Background="#F7FAFD"
                                    Padding="10 8"
                                    Margin="0 0 8 0">
                                <TextBlock x:Name="TxtBackupFolder"
                                           FontSize="12"
                                           Foreground="#4A6FA5"
                                           FontFamily="Segoe UI"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button x:Name="BtnBrowseFolder"
                                    Grid.Column="1"
                                    Content="Browse"
                                    Click="BtnBrowseFolder_Click"
                                    Height="34"
                                    Width="70"
                                    FontSize="12"
                                    FontFamily="Segoe UI"
                                    Foreground="#4A6FA5"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg"
                                                Background="#EEF3FA"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#D8E4F0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="bg"
                                                        Property="Background"
                                                        Value="#D8E4F0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Last Backup Info -->
                        <Border Background="#F7FAFD"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="#E8EDF5"
                                Padding="14"
                                Margin="0 0 0 16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LAST BACKUP"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#8A9BBD"
                                               FontFamily="Segoe UI"
                                               Margin="0 0 0 4" />
                                    <TextBlock x:Name="TxtLastBackup"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#1A2F5A"
                                               FontFamily="Segoe UI" />
                                </StackPanel>

                                <!-- Status indicator -->
                                <Border Grid.Column="1"
                                        x:Name="BackupStatusBadge"
                                        CornerRadius="6"
                                        Padding="10 4"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBackupStatus"
                                               FontSize="11"
                                               FontFamily="Segoe UI"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Warning Message -->
                        <Border x:Name="BackupWarning"
                                Background="#FFF8E7"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="#FFE0A0"
                                Padding="12"
                                Margin="0 0 0 16"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠ "
                                           FontSize="12"
                                           Foreground="#E6A817" />
                                <TextBlock Text="If employees are still checking in/out, please run backup again at end of day for complete data."
                                           FontSize="11"
                                           Foreground="#B07D10"
                                           FontFamily="Segoe UI"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Backup Now Button -->
                        <Button x:Name="BtnBackupNow"
                                Content="☁  Backup Now"
                                Click="BtnBackupNow_Click"
                                Height="40"
                                FontSize="13"
                                FontWeight="SemiBold"
                                FontFamily="Segoe UI"
                                Foreground="White"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg"
                                            Background="#00C9A7"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bg"
                                                    Property="Background"
                                                    Value="#00A88C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
