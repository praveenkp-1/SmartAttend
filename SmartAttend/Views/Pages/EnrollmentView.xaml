<UserControl x:Class="SmartAttend.View.EnrollmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmartAttend.View"
             mc:Ignorable="d"
             Background="#F4F6FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28 20 28 20">

            <!-- ══════════════════════════════════════════════════════
                 PAGE HEADER
            ══════════════════════════════════════════════════════ -->
            <Grid Margin="0 0 0 18">
                <StackPanel>
                    <TextBlock Text="Employee Enrollment"
                               FontFamily="Segoe UI"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1A2F5A" />
                    <TextBlock Text="Create a profile and generate a User ID for biometric enrollment on the device"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#8A9BBD"
                               Margin="0 4 0 0" />
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════
                 STAT CARDS — Enrollment Overview
            ══════════════════════════════════════════════════════ -->
            <UniformGrid Rows="1"
                         Margin="0 0 0 18">

                <!-- Total Employees -->
                <Border Background="White"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#E8EDF5"
                        Margin="0 0 7 0"
                        ClipToBounds="True">
                    <Grid>
                        <Border Height="3"
                                VerticalAlignment="Top"
                                Background="#8A9BBD"
                                CornerRadius="12 12 0 0" />
                        <StackPanel Margin="18 14">
                            <TextBlock Text="Total Employees"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#5E708A"
                                       FontFamily="Segoe UI" />
                            <TextBlock x:Name="TxtTotalCount"
                                       Text="—"
                                       FontSize="28"
                                       FontWeight="Black"
                                       Foreground="#0D1B2A"
                                       FontFamily="Segoe UI"
                                       Margin="0 3 0 0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Fully Enrolled -->
                <Border Background="White"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#E8EDF5"
                        Margin="4 0"
                        ClipToBounds="True">
                    <Grid>
                        <Border Height="3"
                                VerticalAlignment="Top"
                                Background="#00B09C"
                                CornerRadius="12 12 0 0" />
                        <StackPanel Margin="18 14">
                            <TextBlock Text="Fully Enrolled"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#5E708A"
                                       FontFamily="Segoe UI" />
                            <TextBlock x:Name="TxtEnrolledCount"
                                       Text="—"
                                       FontSize="28"
                                       FontWeight="Black"
                                       Foreground="#00B09C"
                                       FontFamily="Segoe UI"
                                       Margin="0 3 0 0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pending Enrollment -->
                <Border Background="White"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#E8EDF5"
                        Margin="7 0 0 0"
                        ClipToBounds="True">
                    <Grid>
                        <Border Height="3"
                                VerticalAlignment="Top"
                                Background="#F5A623"
                                CornerRadius="12 12 0 0" />
                        <StackPanel Margin="18 14">
                            <TextBlock Text="Pending Enrollment"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#5E708A"
                                       FontFamily="Segoe UI" />
                            <TextBlock x:Name="TxtPendingCount"
                                       Text="—"
                                       FontSize="28"
                                       FontWeight="Black"
                                       Foreground="#D4851B"
                                       FontFamily="Segoe UI"
                                       Margin="0 3 0 0" />
                        </StackPanel>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- ══════════════════════════════════════════════════════
                 MAIN: LEFT FORM + RIGHT NEXT-STEPS PANEL
            ══════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <!-- ══ LEFT — New Employee Form ══ -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#E8EDF5"
                        Margin="0 0 14 0"
                        Padding="24">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0 0 0 18">
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="9"
                                    Background="#EEF3FA"
                                    Margin="0 0 10 0">
                                <Viewbox Margin="7">
                                    <Canvas Width="24"
                                            Height="24">
                                        <Path Fill="#1A2F5A"
                                              Data="M12 12c2.7 0 8 1.34 8 4v2H4v-2c0-2.66 5.3-4 8-4zm0-2a4 4 0 1 1 0-8 4 4 0 0 1 0 8z" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="New Employee Profile"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#0D1B2A"
                                           FontFamily="Segoe UI" />
                                <TextBlock Text="Biometric enrollment happens later, on the device"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Foreground="#8A9BBD" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Full Name -->
                        <TextBlock Text="FULL NAME"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI"
                                   Margin="0 0 0 6" />
                        <Border BorderThickness="1"
                                BorderBrush="#DDE4F0"
                                CornerRadius="8"
                                Background="#F8FAFD"
                                Margin="0 0 0 16">
                            <TextBox x:Name="TxtName"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="12"
                                     FontFamily="Segoe UI"
                                     Foreground="#1A2F5A"
                                     Padding="12 9" />
                        </Border>

                        <!-- Department + Position side by side -->
                        <Grid Margin="0 0 0 16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DEPARTMENT"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <ComboBox x:Name="CmbDepartment"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              FontSize="12"
                                              FontFamily="Segoe UI"
                                              Foreground="#1A2F5A"
                                              Padding="10 7"
                                              VerticalContentAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="POSITION"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtPosition"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Contact + Email side by side -->
                        <Grid Margin="0 0 0 22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CONTACT NUMBER"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtContact"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EMAIL"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6" />
                                <Border BorderThickness="1"
                                        BorderBrush="#DDE4F0"
                                        CornerRadius="8"
                                        Background="#F8FAFD">
                                    <TextBox x:Name="TxtEmail"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             Foreground="#1A2F5A"
                                             Padding="12 9" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="Create Profile &amp; Generate ID"
                                    FontSize="12"
                                    FontFamily="Segoe UI"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Height="40"
                                    Margin="0 0 10 0"
                                    Click="CreateProfile_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg"
                                                Background="#00C6AE"
                                                CornerRadius="9">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="bg"
                                                        Property="Background"
                                                        Value="#00b09a" />
                                            </Trigger>
                                            <Trigger Property="IsPressed"
                                                     Value="True">
                                                <Setter TargetName="bg"
                                                        Property="Background"
                                                        Value="#00b09a" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="1"
                                    Content="Clear"
                                    FontSize="12"
                                    FontFamily="Segoe UI"
                                    FontWeight="SemiBold"
                                    Foreground="#1A2F5A"
                                    Cursor="Hand"
                                    Height="40"
                                    Click="Clear_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg"
                                                Background="White"
                                                CornerRadius="9"
                                                BorderThickness="1"
                                                BorderBrush="#DDE4F0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="bg"
                                                        Property="Background"
                                                        Value="#EEF3FA" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ══ RIGHT — Next Steps Panel ══ -->
                <StackPanel Grid.Column="1">

                    <!-- Generated ID card (hidden until profile created) -->
                    <Border x:Name="PnlGeneratedId"
                            Background="White"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="#E8EDF5"
                            Margin="0 0 0 14"
                            Padding="20"
                            Visibility="Collapsed"
                            ClipToBounds="True">
                        <Grid>
                            <Border Height="3"
                                    VerticalAlignment="Top"
                                    Background="#00B09C"
                                    CornerRadius="12 12 0 0" />
                            <StackPanel Margin="0 8 0 0">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0 0 0 10">
                                    <Border Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            Background="#00B09C"
                                            Margin="0 0 8 0">
                                        <TextBlock Text="✓"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Profile created"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#00897B"
                                               FontFamily="Segoe UI"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock x:Name="TxtNewEmployeeName"
                                           Text="—"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#1A2F5A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F8FAFD"
                                            BorderThickness="1"
                                            BorderBrush="#DDE4F0"
                                            CornerRadius="8"
                                            Padding="12 9">
                                        <TextBlock x:Name="TxtUserId"
                                                   Text="—"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   FontFamily="Consolas"
                                                   Foreground="#1A2F5A" />
                                    </Border>
                                    <Button Grid.Column="1"
                                            Content="Copy"
                                            FontSize="11"
                                            FontFamily="Segoe UI"
                                            FontWeight="SemiBold"
                                            Foreground="#00897B"
                                            Cursor="Hand"
                                            Margin="8 0 0 0"
                                            Click="CopyId_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg"
                                                        Background="#E0F5F2"
                                                        CornerRadius="8"
                                                        Padding="14 9">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="bg"
                                                                Property="Background"
                                                                Value="#CCEEE8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- How-to guide -->
                    <Border Background="White"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="#E8EDF5"
                            Padding="22">
                        <StackPanel>

                            <TextBlock Text="How to Complete Enrollment"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#1A2F5A"
                                       Margin="0 0 0 16" />

                            <!-- Step 1 -->
                            <Grid Margin="0 0 0 16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="22"
                                        Height="22"
                                        CornerRadius="11"
                                        Background="#EEF3FA"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="1"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#1A2F5A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Take the generated User ID to the ESP32 enrollment device."
                                           FontSize="12"
                                           Foreground="#4A6590"
                                           FontFamily="Segoe UI"
                                           TextWrapping="Wrap"
                                           Margin="10 1 0 0" />
                            </Grid>

                            <!-- Step 2 -->
                            <Grid Margin="0 0 0 16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="22"
                                        Height="22"
                                        CornerRadius="11"
                                        Background="#EEF3FA"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="2"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#1A2F5A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Select 'New Enrollment' on the device and enter the User ID when prompted."
                                           FontSize="12"
                                           Foreground="#4A6590"
                                           FontFamily="Segoe UI"
                                           TextWrapping="Wrap"
                                           Margin="10 1 0 0" />
                            </Grid>

                            <!-- Step 3 -->
                            <Grid Margin="0 0 0 18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="22"
                                        Height="22"
                                        CornerRadius="11"
                                        Background="#EEF3FA"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="3"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#1A2F5A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Follow the on-device prompts to register fingerprint, RFID, or PIN."
                                           FontSize="12"
                                           Foreground="#4A6590"
                                           FontFamily="Segoe UI"
                                           TextWrapping="Wrap"
                                           Margin="10 1 0 0" />
                            </Grid>

                            <Border BorderThickness="0 1 0 0"
                                    BorderBrush="#EEF3FA"
                                    Margin="0 0 0 14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0"
                                         Width="14"
                                         Height="14"
                                         Margin="0 1 8 0"
                                         VerticalAlignment="Top">
                                    <Canvas Width="24"
                                            Height="24">
                                        <Path Fill="#8A9BBD"
                                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
                                    </Canvas>
                                </Viewbox>

                                <TextBlock Grid.Column="1"
                                           Text="Enrollment status for every employee can be reviewed anytime on the Employees page, under Auth Mode."
                                           FontSize="11"
                                           Foreground="#8A9BBD"
                                           FontFamily="Segoe UI"
                                           TextWrapping="Wrap" />
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>