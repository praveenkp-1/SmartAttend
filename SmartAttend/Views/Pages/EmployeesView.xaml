<UserControl x:Class="SmartAttend.View.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#F7F9FC"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ── COLOUR TOKENS ── -->
        <SolidColorBrush x:Key="Teal"
                         Color="#00C6AE" />
        <SolidColorBrush x:Key="TealDim"
                         Color="#E6FAF8" />
        <SolidColorBrush x:Key="Navy"
                         Color="#0D1B2A" />
        <SolidColorBrush x:Key="Border"
                         Color="#E4EAF2" />
        <SolidColorBrush x:Key="Canvas"
                         Color="#F7F9FC" />
        <SolidColorBrush x:Key="TextSec"
                         Color="#5E708A" />
        <SolidColorBrush x:Key="TextLit"
                         Color="#9EB3CC" />
        <SolidColorBrush x:Key="Red"
                         Color="#FF5A5A" />
        <SolidColorBrush x:Key="Amber"
                         Color="#F59E0B" />
        <SolidColorBrush x:Key="Purple"
                         Color="#7C3AED" />
        <SolidColorBrush x:Key="Blue"
                         Color="#3B82F6" />

        <!-- ── DROP SHADOW ── -->
        <DropShadowEffect x:Key="DropShadow"
                          Color="#000000"
                          Opacity="0.08"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Direction="270" />

        <!-- ── COMBOBOX — borderless, inside the Border wrapper ── -->
        <ControlTemplate x:Key="FlatComboTemplate"
                         TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              Focusable="False"
                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{Binding SelectionBoxItem,
                                                                RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                      Margin="11 0 0 0"
                                                      VerticalAlignment="Center" />
                                    <!-- chevron -->
                                    <Path Grid.Column="1"
                                          Data="M0,0 L4,4 L8,0"
                                          Stroke="#9EB3CC"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup"
                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade"
                       Placement="Bottom">
                    <Border Background="White"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#E4EAF2"
                            MinWidth="{Binding ActualWidth,
                                      RelativeSource={RelativeSource TemplatedParent}}"
                            Effect="{StaticResource DropShadow}">
                        <ScrollViewer MaxHeight="200">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="FlatComboItem"
               TargetType="ComboBoxItem">
            <Setter Property="Padding"
                    Value="12 8" />
            <Setter Property="FontSize"
                    Value="12.5" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="Foreground"
                    Value="#0D1B2A" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#F7F9FC" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#E6FAF8" />
                                <Setter Property="Foreground"
                                        Value="#007d6e" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- ── SMALL ICON BUTTON (Edit / Deactivate / Delete) ── -->
        <Style x:Key="IconBtn"
               TargetType="Button">
            <Setter Property="Width"
                    Value="28" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#E4EAF2" />
            <Setter Property="BorderThickness"
                    Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#00C6AE" />
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#E6FAF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtnWarn"
               TargetType="Button"
               BasedOn="{StaticResource IconBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="BorderBrush"
                            Value="#F59E0B" />
                    <Setter Property="Background"
                            Value="#FFF8E8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconBtnDanger"
               TargetType="Button"
               BasedOn="{StaticResource IconBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="BorderBrush"
                            Value="#FF5A5A" />
                    <Setter Property="Background"
                            Value="#FFF0F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── STAT CHIP ── -->
        <Style x:Key="StatChip"
               TargetType="Border">
            <Setter Property="Padding"
                    Value="18 10" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#E4EAF2" />
            <Setter Property="BorderThickness"
                    Value="0 0 1 0" />
            <Setter Property="Cursor"
                    Value="Hand" />
        </Style>

        <!-- ── FILTER COMBOBOX wrapper style ── -->
        <Style x:Key="FilterCombo"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="Foreground"
                    Value="#5E708A" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#E4EAF2" />
            <Setter Property="BorderThickness"
                    Value="1.5" />
            <Setter Property="Padding"
                    Value="10 0" />
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource FlatComboItem}" />
        </Style>

        <!-- ── PAGINATION BUTTON ── -->
        <Style x:Key="PgBtn"
               TargetType="Button">
            <Setter Property="MinWidth"
                    Value="30" />
            <Setter Property="Height"
                    Value="30" />
            <Setter Property="Padding"
                    Value="8 0" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="FontWeight"
                    Value="Medium" />
            <Setter Property="Foreground"
                    Value="#5E708A" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#E4EAF2" />
            <Setter Property="BorderThickness"
                    Value="1.5" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#00C6AE" />
                                <Setter Property="Foreground"
                                        Value="#00C6AE" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PgBtnActive"
               TargetType="Button"
               BasedOn="{StaticResource PgBtn}">
            <Setter Property="Background"
                    Value="#00C6AE" />
            <Setter Property="BorderBrush"
                    Value="#00C6AE" />
            <Setter Property="Foreground"
                    Value="#0D1B2A" />
            <Setter Property="FontWeight"
                    Value="Bold" />
        </Style>

        <!-- ── GHOST BUTTON ── -->
        <Style x:Key="GhostBtn"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="Padding"
                    Value="14 0" />
            <Setter Property="FontSize"
                    Value="12.5" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="Foreground"
                    Value="#5E708A" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#E4EAF2" />
            <Setter Property="BorderThickness"
                    Value="1.5" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#00C6AE" />
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#E6FAF8" />
                                <Setter Property="Foreground"
                                        Value="#00C6AE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ── DropDownItem BUTTON ── -->
        <Style x:Key="DropdownItemBtn"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="14 9" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#F7F9FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <!-- Toolbar          -->
            <RowDefinition Height="Auto" />
            <!-- Stats chips      -->
            <RowDefinition Height="*" />
            <!-- Table + Pagination -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             ROW 0 — TOOLBAR
        ══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="White"
                BorderThickness="0 0 0 1"
                BorderBrush="#E4EAF2"
                Padding="22 11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- Search     -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Dept       -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Status     -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Auth       -->
                    <ColumnDefinition Width="*" />
                    <!-- Spacer     -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Add btn    -->
                </Grid.ColumnDefinitions>

                <!-- ── Search box ── -->
                <Border Grid.Column="0"
                        BorderThickness="1.5"
                        BorderBrush="#E4EAF2"
                        CornerRadius="8"
                        Background="#F7F9FC"
                        Height="34"
                        Width="260">
                    <Grid>
                        <!-- search icon -->
                        <Viewbox Width="14"
                                 Height="14"
                                 HorizontalAlignment="Left"
                                 Margin="10 0 0 0"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Canvas Width="24"
                                    Height="24">
                                <Ellipse Canvas.Left="3"
                                         Canvas.Top="3"
                                         Width="13"
                                         Height="13"
                                         Stroke="#9EB3CC"
                                         StrokeThickness="2"
                                         Fill="Transparent" />
                                <Line X1="14.5"
                                      Y1="14.5"
                                      X2="20"
                                      Y2="20"
                                      Stroke="#9EB3CC"
                                      StrokeThickness="2" />
                            </Canvas>
                        </Viewbox>
                        <!-- placeholder -->
                        <TextBlock Text="Search by name, ID, department…"
                                   FontSize="12"
                                   FontFamily="Segoe UI"
                                   Foreground="#9EB3CC"
                                   Margin="32 0 0 0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}"
                                                     Value="">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="TxtSearch"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="12"
                                 FontFamily="Segoe UI"
                                 Foreground="#0D1B2A"
                                 Padding="32 0 10 0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="Search_Changed" />
                    </Grid>
                </Border>

                <!-- ── Department filter ── -->
                <Border Grid.Column="1"
                        Margin="8 0 0 0"
                        BorderThickness="1.5"
                        BorderBrush="#E4EAF2"
                        CornerRadius="8"
                        Background="White"
                        Height="34"
                        Width="155">
                    <ComboBox x:Name="CmbDepartment"
                              BorderThickness="0"
                              Background="Transparent"
                              FontSize="12"
                              FontFamily="Segoe UI"
                              Foreground="#5E708A"
                              VerticalContentAlignment="Center"
                              ItemContainerStyle="{StaticResource FlatComboItem}"
                              SelectionChanged="Search_Changed" />
                </Border>

                <!-- ── Status filter ── -->
                <Border Grid.Column="2"
                        Margin="8 0 0 0"
                        BorderThickness="1.5"
                        BorderBrush="#E4EAF2"
                        CornerRadius="8"
                        Background="White"
                        Height="34"
                        Width="120">
                    <ComboBox x:Name="CmbStatus"
                              BorderThickness="0"
                              Background="Transparent"
                              FontSize="12"
                              FontFamily="Segoe UI"
                              Foreground="#5E708A"
                              VerticalContentAlignment="Center"
                              ItemContainerStyle="{StaticResource FlatComboItem}"
                              SelectionChanged="Search_Changed">
                        <ComboBoxItem Content="All Status"
                                      IsSelected="True" />
                        <ComboBoxItem Content="Active" />
                        <ComboBoxItem Content="Inactive" />
                    </ComboBox>
                </Border>

                <!-- ── Auth method filter ── -->
                <Border Grid.Column="3"
                        Margin="8 0 0 0"
                        BorderThickness="1.5"
                        BorderBrush="#E4EAF2"
                        CornerRadius="8"
                        Background="White"
                        Height="34"
                        Width="140">
                    <ComboBox x:Name="CmbAuthMethod"
                              BorderThickness="0"
                              Background="Transparent"
                              FontSize="12"
                              FontFamily="Segoe UI"
                              Foreground="#5E708A"
                              VerticalContentAlignment="Center"
                              ItemContainerStyle="{StaticResource FlatComboItem}"
                              SelectionChanged="Search_Changed">
                        <ComboBoxItem Content="All Auth Methods"
                                      IsSelected="True" />
                        <ComboBoxItem Content="Fingerprint" />
                        <ComboBoxItem Content="RFID" />
                        <ComboBoxItem Content="PIN" />
                    </ComboBox>
                </Border>

                <!-- ── Add Employee button ── -->
                <Button Grid.Column="5"
                        Height="34"
                        Cursor="Hand"
                        Click="AddEmployee_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="#00C6AE"
                                    CornerRadius="8"
                                    Padding="14 0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0 0 0 1">
                                    <!-- plus icon -->
                                    <Viewbox Width="13"
                                             Height="13"
                                             Margin="0 0 6 0">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Line X1="12"
                                                  Y1="5"
                                                  X2="12"
                                                  Y2="19"
                                                  Stroke="#0D1B2A"
                                                  StrokeThickness="2.5" />
                                            <Line X1="5"
                                                  Y1="12"
                                                  X2="19"
                                                  Y2="12"
                                                  Stroke="#0D1B2A"
                                                  StrokeThickness="2.5" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Add Employee"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI"
                                               Foreground="#0D1B2A"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bg"
                                            Property="Background"
                                            Value="#00b09a" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             ROW 1 — STATS CHIPS BAR
        ══════════════════════════════════════════ -->

        <!-- ═══ MINI STAT CARDS ═══ -->
        <UniformGrid Grid.Row="1"
                     Rows="1"
                     Margin="18 14 18 0">

            <!-- All Employees -->
            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="0 0 7 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#00C6AE"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="All Employees"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtTotalCount"
                                   Text="—"
                                   FontSize="25"
                                   FontWeight="Black"
                                   Foreground="#0D1B2A"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active -->
            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="4 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#00C6AE"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="Active"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtActiveCount"
                                   Text="—"
                                   FontSize="25"
                                   FontWeight="Black"
                                   Foreground="#00C6AE"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inactive -->
            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="4 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#5E708A"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="Inactive"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtInactiveCount"
                                   Text="—"
                                   FontSize="25"
                                   FontWeight="Black"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Fingerprint Enrolled -->
            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="7 0 0 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#7C3AED"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="Fingerprint Enrolled"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtFpCount"
                                   Text="—"
                                   FontSize="25"
                                   FontWeight="Black"
                                   Foreground="#7C3AED"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RFID Assigned -->
            <Border Background="White"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="#E4EAF2"
                    Margin="7 0 0 0"
                    ClipToBounds="True">
                <Grid>
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#3B82F6"
                            CornerRadius="9 9 0 0" />
                    <StackPanel Margin="15 10">
                        <TextBlock Text="RFID Cards Assigned"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5E708A"
                                   FontFamily="Segoe UI" />
                        <TextBlock x:Name="TxtRfidCount"
                                   Text="—"
                                   FontSize="25"
                                   FontWeight="Black"
                                   Foreground="#3B82F6"
                                   FontFamily="Segoe UI"
                                   Margin="0 3 0 0" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>



        <!-- ══════════════════════════════════════════
             ROW 2 — TABLE + PAGINATION
        ══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="11"
                BorderThickness="1"
                BorderBrush="#E4EAF2"
                Margin="18 14 18 18"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ── DataGrid ── -->
                <!-- ── LEFT: Header + DataGrid ── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Card header -->
                    <Border Grid.Row="0"
                            BorderThickness="0 0 0 1"
                            BorderBrush="#E4EAF2"
                            Padding="18 13">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Employee Directory"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#0D1B2A"
                                           FontFamily="Segoe UI" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TxtEmployeeCount"
                                           FontSize="11"
                                           Foreground="#9EB3CC"
                                           FontFamily="Segoe UI"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="EmployeeGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0F4F8"
                              VerticalGridLinesBrush="Transparent"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="White"
                              FontFamily="Segoe UI"
                              FontSize="12"
                              Foreground="#0D1B2A"
                              CanUserResizeRows="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              ColumnHeaderHeight="36"
                              RowHeight="52"
                              RowHeaderWidth="0"
                              MouseLeftButtonUp="EmployeeGrid_MouseLeftButtonUp"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </Style>
                        </DataGrid.Resources>

                        <!-- ── Column Header Style ── -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
                                        Value="#FAFBFD" />
                                <Setter Property="Foreground"
                                        Value="#9EB3CC" />
                                <Setter Property="FontSize"
                                        Value="12" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                                <Setter Property="FontFamily"
                                        Value="Segoe UI" />
                                <Setter Property="Padding"
                                        Value="16 0" />
                                <Setter Property="BorderThickness"
                                        Value="0 0 0 1" />
                                <Setter Property="BorderBrush"
                                        Value="#E4EAF2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           FontWeight="{TemplateBinding FontWeight}"
                                                           Foreground="{TemplateBinding Foreground}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- ── Row Style — hover effect ── -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background"
                                        Value="White" />
                                <Setter Property="BorderBrush"
                                        Value="#F0F4F8" />
                                <Setter Property="BorderThickness"
                                        Value="0 0 0 1" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#FAFBFD" />
                                    </Trigger>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#E6FAF8" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- ── Cell Style ── -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Setter Property="BorderThickness"
                                        Value="0" />
                                <Setter Property="FocusVisualStyle"
                                        Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="Transparent" />
                                        <Setter Property="Foreground"
                                                Value="#0D1B2A" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>

                            <!-- ── EMPLOYEE ── -->
                            <DataGridTemplateColumn Header="EMPLOYEE"
                                                    Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="16 0"
                                                    VerticalAlignment="Center">
                                            <!-- Avatar -->
                                            <Border Width="36"
                                                    Height="36"
                                                    CornerRadius="9"
                                                    Background="{Binding AvatarColor}"
                                                    Margin="0 0 11 0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           FontFamily="Segoe UI"
                                                           Foreground="{Binding AvatarTextColor}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <!-- Name / ID / Email -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0D1B2A"
                                                           FontFamily="Segoe UI" />
                                                <TextBlock Text="{Binding UserId}"
                                                           FontSize="10.5"
                                                           Foreground="#9EB3CC"
                                                           FontFamily="Segoe UI"
                                                           Margin="0 1 0 0" />
                                                <TextBlock Text="{Binding Email}"
                                                           FontSize="11"
                                                           Foreground="#5E708A"
                                                           FontFamily="Segoe UI"
                                                           Margin="0 1 0 0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ── DEPARTMENT ── -->
                            <DataGridTextColumn Header="DEPARTMENT"
                                                Binding="{Binding Department}"
                                                Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin"
                                                Value="16 0" />
                                        <Setter Property="VerticalAlignment"
                                                Value="Center" />
                                        <Setter Property="Foreground"
                                                Value="#0D1B2A" />
                                        <Setter Property="FontSize"
                                                Value="12.5" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- ── POSITION ── -->
                            <DataGridTextColumn Header="POSITION"
                                                Binding="{Binding Position}"
                                                Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin"
                                                Value="16 0" />
                                        <Setter Property="VerticalAlignment"
                                                Value="Center" />
                                        <Setter Property="Foreground"
                                                Value="#5E708A" />
                                        <Setter Property="FontSize"
                                                Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- ── AUTH METHODS ── -->
                            <DataGridTemplateColumn Header="AUTH METHODS"
                                                    Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="16 0"
                                                    VerticalAlignment="Center">
                                            <!-- FP -->
                                            <Border CornerRadius="5"
                                                    Padding="7 3"
                                                    Margin="0 0 4 0"
                                                    Background="#EDE9FF">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasFingerprint}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="FP"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#6d28d9"
                                                           FontFamily="Segoe UI" />
                                            </Border>
                                            <!-- RFID -->
                                            <Border CornerRadius="5"
                                                    Padding="7 3"
                                                    Margin="0 0 4 0"
                                                    Background="#DBEAFE">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasRFID}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="RFID"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1d4ed8"
                                                           FontFamily="Segoe UI" />
                                            </Border>
                                            <!-- PIN -->
                                            <Border CornerRadius="5"
                                                    Padding="7 3"
                                                    Background="#FEF3D0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPIN}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="PIN"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#92400e"
                                                           FontFamily="Segoe UI" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ── JOIN DATE ── -->
                            <DataGridTextColumn Header="JOIN DATE"
                                                Binding="{Binding JoinDate}"
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin"
                                                Value="16 0" />
                                        <Setter Property="VerticalAlignment"
                                                Value="Center" />
                                        <Setter Property="Foreground"
                                                Value="#5E708A" />
                                        <Setter Property="FontSize"
                                                Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- ── ATTENDANCE RATE ── -->
                            <!--
                            <DataGridTemplateColumn Header="ATTENDANCE RATE"
                                                    Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="16 0"
                                                    VerticalAlignment="Center">
                                            
                                            <Border Width="70"
                                                    Height="5"
                                                    CornerRadius="3"
                                                    Background="#EEF2F8"
                                                    VerticalAlignment="Center">
                                                
                                                <Border x:Name="RateFill"
                                                        HorizontalAlignment="Left"
                                                        Height="5"
                                                        CornerRadius="3"
                                                        Width="{Binding AttendanceBarWidth}"
                                                        Background="{Binding AttendanceBarColor}" />
                                            </Border>
                                            <TextBlock Text="{Binding AttendanceRateText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding AttendanceBarColor}"
                                                       Margin="8 0 0 0"
                                                       Width="34"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            -->

                            <!-- ── STATUS ── -->
                            <DataGridTemplateColumn Header="STATUS"
                                                    Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5"
                                                Padding="8 3"
                                                HorizontalAlignment="Left"
                                                Margin="16 0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="#D0F5F0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="Inactive">
                                                            <Setter Property="Background"
                                                                    Value="#F0F4F8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="5"
                                                         Height="5"
                                                         Margin="0 0 5 0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill"
                                                                    Value="#00C6AE" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                             Value="Inactive">
                                                                    <Setter Property="Fill"
                                                                            Value="#9EB3CC" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           FontFamily="Segoe UI">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="#007d6e" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                             Value="Inactive">
                                                                    <Setter Property="Foreground"
                                                                            Value="#5E708A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ── LAST SEEN ── -->
                            <DataGridTemplateColumn Header="LAST SEEN"
                                                    Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastSeen}"
                                                   FontSize="12"
                                                   FontFamily="Segoe UI"
                                                   Margin="16 0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="#5E708A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCheckedInToday}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="#00C6AE" />
                                                            <Setter Property="FontWeight"
                                                                    Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ── ACTIONS ── -->
                            <DataGridTemplateColumn Header=""
                                                    Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="8 0"
                                                    VerticalAlignment="Center">

                                            <!-- Fade on hover -->
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Opacity"
                                                            Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                                                         Path="IsMouseOver" />
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Opacity"
                                                                    Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <!-- Edit -->
                                            <Button Style="{StaticResource IconBtn}"
                                                    Tag="{Binding UserId}"
                                                    Margin="0 0 4 0"
                                                    ToolTip="Edit Employee"
                                                    Click="View_Click">
                                                <Viewbox Width="13"
                                                         Height="13">
                                                    <Canvas Width="24"
                                                            Height="24">
                                                        <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z
                                        M20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34
                                        c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                              Fill="#5E708A" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>

                                            <!-- Deactivate -->
                                            <Button Style="{StaticResource IconBtnWarn}"
                                                    Tag="{Binding UserId}"
                                                    Margin="0 0 4 0"
                                                    ToolTip="Deactivate Employee"
                                                    Click="Deactivate_Click">
                                                <Viewbox Width="13"
                                                         Height="13">
                                                    <Canvas Width="24"
                                                            Height="24">
                                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10
                                        10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                                              Fill="#F59E0B" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>

                                            <!-- Delete -->
                                            <Button Style="{StaticResource IconBtnDanger}"
                                                    Tag="{Binding UserId}"
                                                    Margin="0 0 6 0"
                                                    ToolTip="Delete Employee"
                                                    Click="Delete_Click">
                                                <Viewbox Width="13"
                                                         Height="13">
                                                    <Canvas Width="24"
                                                            Height="24">
                                                        <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12z
                                        M19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                              Fill="#FF5A5A" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>

                                            <!-- ── THREE DOT KEBAB ── -->
                                            <Grid>
                                                <Button x:Name="KebabBtn"
                                                        Width="28"
                                                        Height="28"
                                                        Tag="{Binding UserId}"
                                                        Click="Kebab_Click"
                                                        ToolTip="More options">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background"
                                                                    Value="White" />
                                                            <Setter Property="BorderBrush"
                                                                    Value="#E4EAF2" />
                                                            <Setter Property="BorderThickness"
                                                                    Value="1.5" />
                                                            <Setter Property="Cursor"
                                                                    Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver"
                                                                                     Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="#F7F9FC" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                    <!-- Three dots -->
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">
                                                        <Ellipse Width="3"
                                                                 Height="3"
                                                                 Fill="#5E708A"
                                                                 Margin="1 0" />
                                                        <Ellipse Width="3"
                                                                 Height="3"
                                                                 Fill="#5E708A"
                                                                 Margin="1 0" />
                                                        <Ellipse Width="3"
                                                                 Height="3"
                                                                 Fill="#5E708A"
                                                                 Margin="1 0" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Dropdown Popup -->
                                                <Popup x:Name="KebabPopup"
                                                       PlacementTarget="{Binding ElementName=KebabBtn}"
                                                       Placement="Bottom"
                                                       StaysOpen="False"
                                                       AllowsTransparency="True"
                                                       PopupAnimation="Fade">
                                                    <Border Background="White"
                                                            BorderBrush="#E4EAF2"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Padding="0 4"
                                                            MinWidth="170">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#000000"
                                                                              Opacity="0.10"
                                                                              BlurRadius="20"
                                                                              ShadowDepth="4"
                                                                              Direction="270" />
                                                        </Border.Effect>
                                                        <StackPanel>

                                                            <!-- View Details -->
                                                            <Button Tag="{Binding UserId}"
                                                                    Click="KebabViewDetails_Click"
                                                                    Style="{StaticResource DropdownItemBtn}">
                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <Viewbox Width="14"
                                                                             Height="14"
                                                                             Margin="0 0 9 0">
                                                                        <Canvas Width="24"
                                                                                Height="24">
                                                                            <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                                                                  Fill="#5E708A" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <TextBlock Text="View Details"
                                                                               FontSize="12.5"
                                                                               FontFamily="Segoe UI"
                                                                               Foreground="#0D1B2A" />
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- Edit Employee -->
                                                            <Button Tag="{Binding UserId}"
                                                                    Click="KebabEdit_Click"
                                                                    Style="{StaticResource DropdownItemBtn}">
                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <Viewbox Width="14"
                                                                             Height="14"
                                                                             Margin="0 0 9 0">
                                                                        <Canvas Width="24"
                                                                                Height="24">
                                                                            <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z
                                                            M20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34
                                                            c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                                                  Fill="#5E708A" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <TextBlock Text="Edit Employee"
                                                                               FontSize="12.5"
                                                                               FontFamily="Segoe UI"
                                                                               Foreground="#0D1B2A" />
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- Separator -->
                                                            <Border Height="1"
                                                                    Background="#E4EAF2"
                                                                    Margin="0 3" />



                                                            <!-- Delete -->
                                                            <Button Tag="{Binding UserId}"
                                                                    Click="KebabDelete_Click"
                                                                    Style="{StaticResource DropdownItemBtn}">
                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <Viewbox Width="14"
                                                                             Height="14"
                                                                             Margin="0 0 9 0">
                                                                        <Canvas Width="24"
                                                                                Height="24">
                                                                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12z
                                                            M19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                                                  Fill="#FF5A5A" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <TextBlock Text="Delete Employee"
                                                                               FontSize="12.5"
                                                                               FontFamily="Segoe UI"
                                                                               Foreground="#FF5A5A"
                                                                               FontWeight="Medium" />
                                                                </StackPanel>
                                                            </Button>

                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>


                <!-- ── DETAIL DRAWER ── -->
                <Border x:Name="DetailDrawer"
                        Grid.Column="1"
                        Width="0"
                        Background="White"
                        BorderBrush="#E4EAF2"
                        BorderThickness="1 0 0 0"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- HEADER -->
                        <Border Grid.Row="0"
                                Padding="20 18 20 14"
                                BorderBrush="#E4EAF2"
                                BorderThickness="0 0 0 1">
