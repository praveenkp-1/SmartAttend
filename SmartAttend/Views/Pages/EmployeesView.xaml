                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar -->
                                    <Border Grid.Column="0"
                                            x:Name="EditModalAvatar"
                                            Width="54"
                                            Height="54"
                                            CornerRadius="12"
                                            Background="#D0F5F0"
                                            Margin="0 0 14 0">
                                        <TextBlock x:Name="EditModalInitials"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   FontFamily="Segoe UI"
                                                   Foreground="#007d6e"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Name + ID -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="EditModalName"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#0D1B2A"
                                                   FontFamily="Segoe UI" />
                                        <TextBlock x:Name="EditModalId"
                                                   FontSize="11.5"
                                                   Foreground="#9EB3CC"
                                                   FontFamily="Segoe UI"
                                                   Margin="0 2 0 0" />
                                    </StackPanel>

                                    <!-- Status badge -->
                                    <Border Grid.Column="2"
                                            x:Name="EditModalStatusBadge"
                                            Background="#E6FAF8"
                                            CornerRadius="5"
                                            Padding="9 3"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="EditModalStatusText"
                                                   Text="Active"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#007d6e"
                                                   FontFamily="Segoe UI" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- ── SECTION: Personal Information ── -->
                            <TextBlock Text="PERSONAL INFORMATION"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#9EB3CC"
                                       FontFamily="Segoe UI"
                                       Margin="0 0 0 10" />
                            <Border BorderBrush="#E4EAF2"
                                    BorderThickness="0 0 0 1"
                                    Margin="0 0 0 16" />

                            <Grid Margin="0 0 0 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Full Name -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Full Name *"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#5E708A"
                                               FontFamily="Segoe UI"
                                               Margin="0 0 0 5" />

                                    <Border BorderThickness="1"
                                            BorderBrush="#D8E4F0"
                                            CornerRadius="8"
                                            Background="#F7FAFD"
                                            Margin="0 0 0 14">
                                        <TextBox x:Name="EditFullName"
                                                 Height="36"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="13"
                                                 FontFamily="Segoe UI"
                                                 Foreground="#1A3A6B"
                                                 Padding="11 0"
                                                 VerticalContentAlignment="Center" />
                                    </Border>




                                </StackPanel>

                                <!-- Employee ID (readonly) -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Employee ID"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#5E708A"
                                               FontFamily="Segoe UI"
                                               Margin="0 0 0 5" />
                                    <Border BorderThickness="1"
                                            BorderBrush="#D8E4F0"
                                            CornerRadius="8"
                                            Background="#F7FAFD"
                                            Margin="0 0 0 14">
                                        <TextBox x:Name="EditEmpId"
                                                 IsReadOnly="True"
                                                 Height="36"
                                                 Padding="11 0"
                                                 FontSize="13"
                                                 FontFamily="Segoe UI"
                                                 Foreground="#9EB3CC"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center">

                                        </TextBox>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Contact -->
                            <StackPanel Margin="0 0 0 12">
                                <TextBlock Text="Phone Number"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 5" />
                                <Border BorderThickness="1"
                                        BorderBrush="#D8E4F0"
                                        CornerRadius="8"
                                        Background="#F7FAFD"
                                        Margin="0 0 0 14">
                                    <TextBox x:Name="EditContact"
                                             Height="36"
                                             Padding="11 0"
                                             FontSize="13"
                                             FontFamily="Segoe UI"
                                             Foreground="#0D1B2A"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <!-- ── SECTION: Work Information ── -->
                            <TextBlock Text="WORK INFORMATION"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#9EB3CC"
                                       FontFamily="Segoe UI"
                                       Margin="0 8 0 10" />
                            <Border BorderBrush="#E4EAF2"
                                    BorderThickness="0 0 0 1"
                                    Margin="0 0 0 16" />

                            <Grid Margin="0 0 0 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Department -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Department *"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#5E708A"
                                               FontFamily="Segoe UI"
                                               Margin="0 0 0 5" />

                                    <Border Grid.Column="1"
                                            Margin="0 0 0 0"
                                            BorderThickness="1.5"
                                            BorderBrush="#E4EAF2"
                                            CornerRadius="8"
                                            Background="White"
                                            Height="36">
                                        <ComboBox x:Name="EditDepartment"
                                                  BorderThickness="0"
                                                  Background="White"
                                                  FontSize="12"
                                                  FontFamily="Segoe UI"
                                                  Foreground="#5E708A"
                                                  VerticalContentAlignment="Center"
                                                  Template="{StaticResource FlatComboTemplate}"
                                                  ItemContainerStyle="{StaticResource FlatComboItem}" />
                                    </Border>


                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Position / Job Title *"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#5E708A"
                                               FontFamily="Segoe UI"
                                               Margin="0 0 0 5" />
                                    <Border BorderThickness="1"
                                            BorderBrush="#D8E4F0"
                                            CornerRadius="8"
                                            Background="#F7FAFD"
                                            Margin="0 0 0 14">
                                        <TextBox x:Name="EditPosition"
                                                 Height="36"
                                                 Padding="11 0"
                                                 FontSize="13"
                                                 FontFamily="Segoe UI"
                                                 Foreground="#0D1B2A"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center" />
                                    </Border>
                                </StackPanel>




                            </Grid>

                            <Grid Margin="0 0 0 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>



                                <!-- Join Date -->
                                <StackPanel Margin="0 0 0 12">
                                    <TextBlock Text="Join Date"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#5E708A"
                                               FontFamily="Segoe UI"
                                               Margin="0 0 0 5" />

                                    <Border Grid.Column="0"
                                            BorderThickness="1"
                                            BorderBrush="#D8E4F0"
                                            CornerRadius="8"
                                            Background="White"
                                            Margin="0 0 8 0">
                                        <DatePicker x:Name="EditJoinDate"
                                                    Height="36"
                                                    FontSize="13"
                                                    FontFamily="Segoe UI"
                                                    BorderThickness="0"
                                                    Foreground="#0D1B2A"
                                                    Margin="10 0"
                                                    VerticalContentAlignment="Center" />

                                    </Border>
                                </StackPanel>

                                <!-- Status -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Employee Status"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#5E708A"
                                               FontFamily="Segoe UI"
                                               Margin="0 0 0 5" />

                                    <Border Grid.Column="1"
                                            Margin="0 0 0 0"
                                            BorderThickness="1.5"
                                            BorderBrush="#E4EAF2"
                                            CornerRadius="8"
                                            Background="White"
                                            Height="36">
                                        <ComboBox x:Name="EditStatus"
                                                  BorderThickness="0"
                                                  Background="White"
                                                  FontSize="12"
                                                  FontFamily="Segoe UI"
                                                  Foreground="#5E708A"
                                                  VerticalContentAlignment="Center"
                                                  Template="{StaticResource FlatComboTemplate}"
                                                  ItemContainerStyle="{StaticResource FlatComboItem}">
                                            <ComboBoxItem Content="Active" />
                                            <ComboBoxItem Content="Inactive" />
                                        </ComboBox>
                                    </Border>


                                </StackPanel>

                            </Grid>




                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── FOOTER ── -->
                    <Border Grid.Row="2"
                            Padding="24 14"
                            BorderBrush="#E4EAF2"
                            BorderThickness="0 1 0 0">
                        <Grid>
                            <TextBlock Text="* Required fields"
                                       FontSize="11"
                                       Foreground="#9EB3CC"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Click="EditModalClose_Click"
                                        Height="36"
                                        Padding="18 0"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        FontFamily="Segoe UI"
                                        Cursor="Hand"
                                        Margin="0 0 8 0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background"
                                                    Value="Transparent" />
                                            <Setter Property="Foreground"
                                                    Value="#5E708A" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E4EAF2" />
                                            <Setter Property="BorderThickness"
                                                    Value="1.5" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#F7F9FC" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Save Changes"
                                        Click="EditModalSave_Click"
                                        Height="36"
                                        Padding="18 0"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        FontFamily="Segoe UI"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background"
                                                    Value="#00C6AE" />
                                            <Setter Property="Foreground"
                                                    Value="#0D1B2A" />
                                            <Setter Property="BorderThickness"
                                                    Value="0" />
                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#00b09a" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>

        </Grid>
    </Grid>

</UserControl>
