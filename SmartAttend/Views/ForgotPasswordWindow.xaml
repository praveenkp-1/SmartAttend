<Window x:Class="SmartAttend.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Icon="C:\Users\kp\Desktop\smartAttendanceSystem-master\SmartAttend\Assets\smartattend.ico"
        Title="SmartAttend — Forgot Password"
        Height="580"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF3FA">
    <Grid>
        <Border Background="#FFFFFF"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="#D8E4F0"
                Width="340"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="32"
                Margin="0 32">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden">

                <StackPanel>

                    <!-- Logo -->
                    <Border Width="56"
                            Height="56"
                            CornerRadius="14"
                            Background="#EEF3FA"
                            BorderThickness="1"
                            BorderBrush="#D8E4F0"
                            HorizontalAlignment="Center"
                            Margin="0 0 0 14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Background="#1A3A6B"
                                    Margin="8 8 4 4"
                                    CornerRadius="3" />
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Background="#1A3A6B"
                                    Margin="4 8 8 4"
                                    CornerRadius="3" />
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Background="#1A3A6B"
                                    Margin="8 4 4 8"
                                    CornerRadius="3" />
                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Background="#378ADD"
                                    Margin="4 4 8 8"
                                    CornerRadius="3" />
                        </Grid>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="Forgot Password"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1A3A6B"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Answer your security question to reset"
                               FontSize="11"
                               Foreground="#8AAAC8"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center"
                               Margin="0 4 0 24" />

                    <!-- Username -->
                    <TextBlock Text="USERNAME"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#6A8BB5"
                               FontFamily="Segoe UI"
                               Margin="0 0 0 5" />
                    <Border BorderThickness="1"
                            BorderBrush="#D8E4F0"
                            CornerRadius="8"
                            Background="#F7FAFD"
                            Margin="0 0 0 14">
                        <TextBox x:Name="TxtUsername"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 FontFamily="Segoe UI"
                                 Foreground="#1A3A6B"
                                 Padding="12 9" />
                    </Border>

                    <!-- Security Question (shown after username verified) -->
                    <StackPanel x:Name="PanelQuestion"
                                Visibility="Collapsed">

                        <TextBlock Text="SECURITY QUESTION"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#6A8BB5"
                                   FontFamily="Segoe UI"
                                   Margin="0 0 0 5" />
                        <Border BorderThickness="1"
                                BorderBrush="#D8E4F0"
                                CornerRadius="8"
                                Background="#F0F5FB"
                                Margin="0 0 0 14"
                                Padding="12 10">
                            <TextBlock x:Name="TxtQuestion"
                                       FontSize="13"
                                       FontFamily="Segoe UI"
                                       Foreground="#1A3A6B"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Security Answer -->
                        <TextBlock Text="YOUR ANSWER"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#6A8BB5"
                                   FontFamily="Segoe UI"
                                   Margin="0 0 0 5" />
                        <Border BorderThickness="1"
                                BorderBrush="#D8E4F0"
                                CornerRadius="8"
                                Background="#F7FAFD"
                                Margin="0 0 0 14">
                            <TextBox x:Name="TxtAnswer"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13"
                                     FontFamily="Segoe UI"
                                     Foreground="#1A3A6B"
                                     Padding="12 9" />
                        </Border>

                        <!-- New Password -->
                        <TextBlock Text="NEW PASSWORD"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#6A8BB5"
                                   FontFamily="Segoe UI"
                                   Margin="0 0 0 5" />
                        <Border BorderThickness="1"
                                BorderBrush="#D8E4F0"
                                CornerRadius="8"
                                Background="#F7FAFD"
                                Margin="0 0 0 14">
                            <PasswordBox x:Name="TxtNewPassword"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="13"
                                         FontFamily="Segoe UI"
                                         Foreground="#1A3A6B"
                                         Padding="12 9" />
                        </Border>

                        <!-- Confirm New Password -->
                        <TextBlock Text="CONFIRM NEW PASSWORD"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#6A8BB5"
                                   FontFamily="Segoe UI"
                                   Margin="0 0 0 5" />
                        <Border BorderThickness="1"
                                BorderBrush="#D8E4F0"
                                CornerRadius="8"
                                Background="#F7FAFD"
                                Margin="0 0 0 6">
                            <PasswordBox x:Name="TxtConfirmPassword"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="13"
                                         FontFamily="Segoe UI"
                                         Foreground="#1A3A6B"
                                         Padding="12 9" />
                        </Border>

                    </StackPanel>

                    <!-- Message (error or success) -->
                    <TextBlock x:Name="TxtMessage"
                               Text=""
                               FontSize="11"
                               Foreground="#C0392B"
                               FontFamily="Segoe UI"
                               Margin="0 0 0 10"
                               Visibility="Collapsed"
                               TextWrapping="Wrap" />

                    <!-- Primary Button (label changes) -->
                    <Button x:Name="BtnPrimary"
                            Content="Verify Username"
                            Click="BtnPrimary_Click"
                            Height="40"
                            FontSize="13"
                            FontWeight="SemiBold"
                            FontFamily="Segoe UI"
                            Foreground="White"
                            Cursor="Hand"
                            Margin="0 8 0 0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        Background="#1A3A6B"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="bg"
                                                Property="Background"
                                                Value="#22488A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Back to Login -->
                    <Button Content="← Back to Login"
                            Click="BtnBack_Click"
                            Height="36"
                            FontSize="12"
                            FontFamily="Segoe UI"
                            Cursor="Hand"
                            Margin="0 6 0 0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>
                            <SolidColorBrush Color="#6A8BB5" />
                        </Button.Foreground>
                    </Button>

                    <!-- Version -->
                    <TextBlock Text="Smart Biometric Attendance System v1.0"
                               FontSize="10"
                               Foreground="#8AAAC8"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center"
                               Margin="0 10 0 0" />

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>