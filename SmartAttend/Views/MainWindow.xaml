<Window x:Class="SmartAttend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Icon="C:\Users\kp\Desktop\smartAttendanceSystem-master\SmartAttend\Assets\smartattend.ico"
        Title="SmartAttend — Biometric Employee Attendance System"
        Height="740"
        Width="1140"
        MinHeight="620"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0D1B2A">

    <Window.Resources>

        <!-- ═══ COLOR RESOURCES ═══ -->
        <SolidColorBrush x:Key="Navy"
                         Color="#0D1B2A" />
        <SolidColorBrush x:Key="NavyMid"
                         Color="#1A2D42" />
        <SolidColorBrush x:Key="NavyLit"
                         Color="#1E3A5F" />
        <SolidColorBrush x:Key="Teal"
                         Color="#00C6AE" />
        <SolidColorBrush x:Key="TealDim"
                         Color="#1A3D38" />
        <SolidColorBrush x:Key="Canvas"
                         Color="#F7F9FC" />
        <SolidColorBrush x:Key="Surface"
                         Color="#FFFFFF" />
        <SolidColorBrush x:Key="Border"
                         Color="#E4EAF2" />
        <SolidColorBrush x:Key="TextPri"
                         Color="#0D1B2A" />
        <SolidColorBrush x:Key="TextSec"
                         Color="#5E708A" />
        <SolidColorBrush x:Key="TextLit"
                         Color="#9EB3CC" />
        <SolidColorBrush x:Key="Red"
                         Color="#FF5A5A" />
        <SolidColorBrush x:Key="Amber"
                         Color="#F59E0B" />

        <!-- ═══ NAV ITEM STYLE (inactive) ═══ -->
        <Style x:Key="NavBtn"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="#6B84A0" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Height"
                    Value="38" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="FontWeight"
                    Value="Medium" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Margin"
                    Value="6 1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10 0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="bg"
                                        Property="Background"
                                        Value="#0D2030" />
                                <Setter Property="Foreground"
                                        Value="#B8D0E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ NAV ITEM STYLE (active) ═══ -->
        <Style x:Key="NavBtnActive"
               TargetType="Button"
               BasedOn="{StaticResource NavBtn}">
            <Setter Property="Background"
                    Value="#0D2E28" />
            <Setter Property="Foreground"
                    Value="#00C6AE" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>

        <!-- ═══ NAV SECTION LABEL ═══ -->
        <Style x:Key="NavLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="9.5" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Foreground"
                    Value="#2E4A62" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="Margin"
                    Value="18 14 0 4" />
        </Style>

        <!-- ═══ SIGN OUT BUTTON ═══ -->
        <Style x:Key="NavBtnRed"
               TargetType="Button"
               BasedOn="{StaticResource NavBtn}">
            <Setter Property="Foreground"
                    Value="#FF6B6B" />
        </Style>

        <!-- ═══ TOPBAR ICON BUTTON ═══ -->
        <Style x:Key="IconBtn"
               TargetType="Button">
            <Setter Property="Width"
                    Value="34" />
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="Foreground"
                    Value="#5E708A" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="BorderBrush"
                    Value="#E4EAF2" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="bg"
                                        Property="Background"
                                        Value="#F7F9FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════
                 SIDEBAR 
            Background="#0D1B2A",BorderBrush="#0F2030"
            ═══════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="#F7F9FC"
                    BorderThickness="0 0 1 0"
                    BorderBrush="#E4EAF2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <Border Grid.Row="0"
                            BorderThickness="0 0 0 1"
                            BorderBrush="#E4EAF2"
                            Padding="18 18 18 14">
                        <StackPanel Orientation="Horizontal">
                            <!-- Logo Icon -->
                            <Border Width="38"
                                    Height="38"
                                    CornerRadius="10"
                                    Background="#EEF3FA"
                                    BorderThickness="1"
                                    Margin="0 0 10 0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            Background="#1A3A6B"
                                            Margin="5 5 2 2"
                                            CornerRadius="2" />
                                    <Border Grid.Row="0"
                                            Grid.Column="1"
                                            Background="#1A3A6B"
                                            Margin="2 5 5 2"
                                            CornerRadius="2" />
                                    <Border Grid.Row="1"
                                            Grid.Column="0"
                                            Background="#1A3A6B"
                                            Margin="5 2 2 5"
                                            CornerRadius="2" />
                                    <Border Grid.Row="1"
                                            Grid.Column="1"
                                            Background="#378ADD"
                                            Margin="2 2 5 5"
                                            CornerRadius="2" />
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SmartAttend"
                                           FontSize="15"
                                           FontWeight="Black"
                                           Foreground="#1A3A6B"
                                           FontFamily="Segoe UI" />
                                <TextBlock Text="ATTENDANCE SYSTEM"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="#2E4A62"
                                           FontFamily="Segoe UI"
                                           Margin="0 2 0 0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nav Items -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  Padding="10 10 10 0">
                        <StackPanel>

                            <TextBlock Text="OVERVIEW"
                                       Style="{StaticResource NavLabel}" />

                            <!-- Dashboard -->
                            <Button x:Name="BtnDashboard"
                                    Style="{StaticResource NavBtnActive}"
                                    Tag="Dashboard"
                                    Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15"
                                             Height="15"
                                             Margin="0 0 10 0">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Rectangle Canvas.Left="3"
                                                       Canvas.Top="3"
                                                       Width="8"
                                                       Height="8"
                                                       RadiusX="1"
                                                       RadiusY="1"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Rectangle Canvas.Left="13"
                                                       Canvas.Top="3"
                                                       Width="8"
                                                       Height="8"
                                                       RadiusX="1"
                                                       RadiusY="1"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Rectangle Canvas.Left="3"
                                                       Canvas.Top="13"
                                                       Width="8"
                                                       Height="8"
                                                       RadiusX="1"
                                                       RadiusY="1"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Rectangle Canvas.Left="13"
                                                       Canvas.Top="13"
                                                       Width="8"
                                                       Height="8"
                                                       RadiusX="1"
                                                       RadiusY="1"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Dashboard"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="PEOPLE"
                                       Style="{StaticResource NavLabel}" />

                            <!-- Employees -->
                            <Button x:Name="BtnEmployees"
                                    Style="{StaticResource NavBtn}"
                                    Tag="Employees"
                                    Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15"
                                             Height="15"
                                             Margin="0 0 10 0">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Ellipse Canvas.Left="8"
                                                     Canvas.Top="2"
                                                     Width="8"
                                                     Height="8"
                                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Path Data="M4,20 C4,16 8,13 12,13 C16,13 20,16 20,20"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"
                                                  Fill="Transparent" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Employees"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI" />
                                    <!-- TODO: wire badge to employee count -->

                                </StackPanel>
                            </Button>

                            <!-- Enrollment -->
                            <Button x:Name="BtnEnrollment"
                                    Style="{StaticResource NavBtn}"
                                    Tag="Enrollment"
                                    Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15"
                                             Height="15"
                                             Margin="0 0 10 0">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Ellipse Canvas.Left="5"
                                                     Canvas.Top="2"
                                                     Width="8"
                                                     Height="8"
                                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Path Data="M2,20 C2,16 6,13 9,13"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"
                                                  Fill="Transparent" />
                                            <Line X1="16"
                                                  Y1="12"
                                                  X2="16"
                                                  Y2="20"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" />
                                            <Line X1="12"
                                                  Y1="16"
                                                  X2="20"
                                                  Y2="16"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Enrollment"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="RECORDS"
                                       Style="{StaticResource NavLabel}" />

                            <!-- Attendance -->
                            <Button x:Name="BtnAttendance"
                                    Style="{StaticResource NavBtn}"
                                    Tag="Attendance"
                                    Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15"
                                             Height="15"
                                             Margin="0 0 10 0">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Rectangle Canvas.Left="3"
                                                       Canvas.Top="4"
                                                       Width="18"
                                                       Height="16"
                                                       RadiusX="2"
                                                       RadiusY="2"
                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       StrokeThickness="1.5"
                                                       Fill="Transparent" />
                                            <Line X1="8"
                                                  Y1="2"
                                                  X2="8"
                                                  Y2="6"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" />
                                            <Line X1="16"
                                                  Y1="2"
                                                  X2="16"
                                                  Y2="6"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" />
                                            <Line X1="3"
                                                  Y1="10"
                                                  X2="21"
                                                  Y2="10"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Attendance"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI" />
                                    <!-- TODO: wire to unresolved/late count -->

                                </StackPanel>
                            </Button>

                            <!-- Reports -->
                            <Button x:Name="BtnReports"
                                    Style="{StaticResource NavBtn}"
                                    Tag="Reports"
                                    Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15"
                                             Height="15"
                                             Margin="0 0 10 0">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Rectangle Canvas.Left="4"
                                                       Canvas.Top="2"
                                                       Width="16"
                                                       Height="20"
                                                       RadiusX="2"
                                                       RadiusY="2"
                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       StrokeThickness="1.5"
                                                       Fill="Transparent" />
                                            <Line X1="8"
                                                  Y1="8"
                                                  X2="16"
                                                  Y2="8"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" />
                                            <Line X1="8"
                                                  Y1="12"
                                                  X2="16"
                                                  Y2="12"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" />
                                            <Line X1="8"
                                                  Y1="16"
                                                  X2="13"
                                                  Y2="16"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Reports"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI" />
                                </StackPanel>
                            </Button>

                            <TextBlock />



                            <!-- Settings -->
                            <Button x:Name="BtnSettings"
                                    Style="{StaticResource NavBtn}"
                                    Tag="Settings"
                                    Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15"
                                             Height="15"
                                             Margin="0 0 10 0">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Ellipse Canvas.Left="9"
                                                     Canvas.Top="9"
                                                     Width="6"
                                                     Height="6"
                                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                     StrokeThickness="1.5"
                                                     Fill="Transparent" />
                                            <Path Data="M12,2 L12,4 M12,20 L12,22 M2,12 L4,12 M20,12 L22,12 M4.9,4.9 L6.3,6.3 M17.7,17.7 L19.1,19.1 M19.1,4.9 L17.7,6.3 M6.3,17.7 L4.9,19.1"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Settings"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI" />
                                </StackPanel>
                            </Button>

                            <!-- Divider 
                            <Border Height="1" Background="#0F2030" Margin="8 10"/>
                                      -->
                            <!-- Sign Out -->
                            <Button Style="{StaticResource NavBtnRed}"
                                    Click="SignOut_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15"
                                             Height="15"
                                             Margin="0 0 10 0">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Path Data="M9,4 L4,4 L4,20 L9,20"
                                                  Stroke="#FF6B6B"
                                                  StrokeThickness="1.5"
                                                  Fill="Transparent" />
                                            <Path Data="M14,8 L19,12 L14,16"
                                                  Stroke="#FF6B6B"
                                                  StrokeThickness="1.5"
                                                  Fill="Transparent" />
                                            <Line X1="19"
                                                  Y1="12"
                                                  X2="9"
                                                  Y2="12"
                                                  Stroke="#FF6B6B"
                                                  StrokeThickness="1.5" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Sign Out"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer — Device Status -->
                    <Border Grid.Row="2"
                            BorderThickness="0 1 0 0"
                            BorderBrush="#E4EAF2"
                            Padding="12 12">
                        <Border Background="#1A2D42"
                                CornerRadius="9"
                                BorderThickness="1"
                                BorderBrush="#1E3A5F"
                                Padding="12 10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Pulse dot -->
                                <Ellipse x:Name="DeviceStatusDot"
                                         Width="8"
                                         Height="8"
                                         Fill="#FF5A5A"
                                         VerticalAlignment="Center"
                                         Margin="0 0 10 0" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDeviceStatus"
                                               Text="Device Offline"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               FontFamily="Segoe UI" />
                                    <TextBlock x:Name="TxtDeviceIp"
                                               Text="Not connected"
                                               FontSize="10"
                                               Foreground="#3A6080"
                                               FontFamily="Segoe UI"
                                               Margin="0 2 0 0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                </Grid>
            </Border>

            <!-- ═══════════════════════════════════
                 MAIN AREA
            ═══════════════════════════════════ -->
            <Grid Grid.Column="1"
                  Background="#F7F9FC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- TOP BAR -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderThickness="0 0 0 1"
                        BorderBrush="#E4EAF2">
                    <Grid Margin="26 0">
                        <!-- Left: page title + subtitle -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TopTitle"
                                       Text="Dashboard"
                                       FontSize="16"
                                       FontWeight="Black"
                                       Foreground="#0D1B2A"
                                       FontFamily="Segoe UI" />
                            <TextBlock x:Name="TopDate"
                                       FontSize="11"
                                       Foreground="#9EB3CC"
                                       FontFamily="Segoe UI"
                                       Margin="0 1 0 0" />
                        </StackPanel>

                        <!-- Right: clock + notification + refresh + avatar -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.329,0.565">

                            <!-- Clock chip  TODO: wire to DispatcherTimer -->
                            <Border Background="#F7F9FC"
                                    BorderThickness="1"
                                    BorderBrush="#E4EAF2"
                                    CornerRadius="7"
                                    Padding="11 5"
                                    Margin="0 0 8 0">
                                <TextBlock x:Name="TxtClock"
                                           Text="00:00:00"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#5E708A"
                                           FontFamily="Segoe UI"
                                           Margin="8 3 8 0" />
                            </Border>

                            <!-- Notification bell  TODO: wire to alert count 
                            <Button Style="{StaticResource IconBtn}"
                                    Margin="0 0 6 0"
                                    ToolTip="Notifications">
                                <Grid>
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12,22 C13.1,22 14,21.1 14,20 L10,20 C10,21.1 10.9,22 12,22z" Fill="#5E708A"/>
                                            <Path Data="M18,17 L18,12 C18,8.93 16.36,6.36 13.5,5.68 L13.5,5 C13.5,4.17 12.83,3.5 12,3.5 C11.17,3.5 10.5,4.17 10.5,5 L10.5,5.68 C7.63,6.36 6,8.92 6,12 L6,17 L4,19 L4,20 L20,20 L20,19 L18,17z" Fill="#5E708A"/>
                                        </Canvas>
                                    </Viewbox>  -->
                            <!-- Red dot  TODO: hide when no alerts 
                                    <Ellipse Width="7" Height="7"
                                             Fill="#FF5A5A"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0 6 6 0"/>
                                </Grid>
                            </Button>  -->

                            <!-- Refresh  TODO: wire to reload current page -->
                            <!--   <Button Style="{StaticResource IconBtn}"
                                    Margin="0 0 10 0"
                                    ToolTip="Refresh">
                                <Viewbox Width="16"
                                         Height="16">
                                    <Canvas Width="24"
                                            Height="24">
                                        <Path Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4.01,12 C4.01,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 L17.65,6.35z"
                                              Fill="#5E708A" />
                                    </Canvas>
                                </Viewbox>
                            </Button> -->

                            <!-- User avatar
                            <Border Width="34" Height="34"
                                    CornerRadius="9"
                                    Background="#00C6AE">
                                <TextBlock x:Name="TxtManagerInitial"
                                           Text="A"
                                           FontSize="12" FontWeight="Black"
                                           Foreground="#0D1B2A"
                                           FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                             -->

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PAGE CONTENT -->
                <ContentControl x:Name="MainContent"
                                Grid.Row="1" />

            </Grid>

        </Grid>
    </Border>

</Window>